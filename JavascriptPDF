        aoa.push(['DISEDIAKAN OLEH (PT/PPRD ):', '', '', '', '', '', '', '', '', '', 'DISEMAK OLEH (PRD/PPRD):', '', '', '', '', '', '', '', '', '', 'DILULUSKAN OLEH (PRN/KOMANDAN/PO/EO):']);
        aoa.push([]);
        aoa.push(['TANDATANGAN:', '', '', '', '', '', '', '', '', '', 'TANDATANGAN:', '', '', '', '', '', '', '', '', '', 'TANDATANGAN:']);
