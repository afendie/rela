          { s: { r: 3, c: 0 }, e: { r: 3, c: maxD + 8 } },
          { s: { r: 5, c: 0 }, e: { r: 6, c: 0 } }, // BIL
          { s: { r: 5, c: 1 }, e: { r: 6, c: 1 } }, // NAMA PETUGAS
          { s: { r: 5, c: 2 }, e: { r: 5, c: maxD + 1 } }, // TARIKH & JAM (1-31)
          { s: { r: 5, c: maxD + 2 }, e: { r: 6, c: maxD + 2 } }, // BIL. HARI
          { s: { r: 5, c: maxD + 3 }, e: { r: 6, c: maxD + 3 } }, // BIL. JAM
          { s: { r: 5, c: maxD + 4 }, e: { r: 6, c: maxD + 4 } }, // KADAR TUNTUTAN SEJAM
          { s: { r: 5, c: maxD + 5 }, e: { r: 6, c: maxD + 5 } }, // JUMLAH ELAUN
          { s: { r: 5, c: maxD + 6 }, e: { r: 6, c: maxD + 6 } }, // JUMLAH INSENTIF
          { s: { r: 5, c: maxD + 7 }, e: { r: 6, c: maxD + 7 } }, // JUMLAH SME
          { s: { r: 5, c: maxD + 8 }, e: { r: 6, c: maxD + 8 } }, // JUMLAH
          { s: { r: 7 + activeMems.length, c: 0 }, e: { r: 7 + activeMems.length, c: 1 } }, // JUMLAH JAM SEHARI
          { s: { r: 8 + activeMems.length, c: 0 }, e: { r: 8 + activeMems.length, c: maxD + 4 } }, // JUMLAH KESELURUHAN label
