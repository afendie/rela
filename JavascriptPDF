    let isPreviewReady = false;
    if (window.currentPdfHandshake) {
      window.removeEventListener('message', window.currentPdfHandshake);
      window.currentPdfHandshake = null;
    }
    const handleHandshake = (event) => {
      try {
        const expectedOrigin = new URL(previewUrl).origin;
        if (event.origin !== expectedOrigin) return;
      } catch (err) {
        return;
      }
      
      if (event.data && event.data.type === 'PREVIEW_READY') {
        isPreviewReady = true;
        attemptSend();
      }
    };
    window.currentPdfHandshake = handleHandshake;
    window.addEventListener('message', handleHandshake);
    function attemptSend() {
      if (isPreviewReady && pdfGeneratedData) {
        const targetOrigin = new URL(previewUrl).origin;
        previewWin.postMessage({
          type: 'PDF_DATA',
          data: pdfGeneratedData.uri,
          filename: pdfGeneratedData.filename,
          title: 'Lampiran AFFIN'
        }, targetOrigin);
        
        window.removeEventListener('message', handleHandshake);
        window.currentPdfHandshake = null;
        showLoading(false);
      }
