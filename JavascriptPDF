      try {
        const maxD = new Date(st.year, st.month, 0).getDate();
        let reportLocIds = [];
        if (st.locId === 'all') {
          if (st.role === 'admin') reportLocIds = st.db.locations.map(l => l.id);
          else reportLocIds = st.allowedLocs.split(',');
        } else {
          reportLocIds = [st.locId];
        }

        const mems = st.db.members.filter(m => reportLocIds.includes(m.locId));
        let activeMems = mems.filter((m) => calcMemberStats(m.id, st).hrs > 0);
        const enabledNbcLocs = (st.db.settings.nbc_enabled_locations || '').split(',');

        let locNameDisplay = reportLocIds.length === 1 
          ? (st.db.locations.find(l => l.id === reportLocIds[0])?.name || "LOKASI").toUpperCase() 
          : `KUMULATIF LOKASI`;

        const daerahText = (st.db.settings.report_daerah || 'BATU PAHAT').toUpperCase();
        const bulanNama = M_NAMES[st.month - 1].toUpperCase();

        let aoa = [];
        // Pengepala Utama Format Baharu
        aoa.push(['RUMUSAN TUNTUTAN PEMBAYARAN PTJ RELA']);
        aoa.push(['JABATAN SUKARELAWAN MALAYSIA (RELA)']);
        aoa.push([`LOKASI PENUGASAN: ${locNameDisplay}`]);
        aoa.push([`DAERAH: ${daerahText} NEGERI: JOHOR BULAN: ${bulanNama} TAHUN: ${st.year}`]);
        aoa.push([]);

        // Pengepala Baris 1
        let h1 = ['BIL', 'NAMA PETUGAS'];
        h1.push(`TARIKH DAN JUMLAH JAM BERTUGAS (8JAM = 8) (TIDAK BERTUGAS = 0)`);
        for (let d = 2; d <= maxD; d++) h1.push('');
        h1.push('BIL. HARI', 'BIL. JAM', 'KADAR TUNTUTAN SEJAM (RM)', 'JUMLAH ELAUN (RM)', 'JUMLAH INSENTIF (RM)', 'JUMLAH SME (RM)', 'JUMLAH (RM)');
        aoa.push(h1);

        // Pengepala Baris 2 (Nombor Hari 1 - 31)
        let h2 = ['', ''];
        for (let d = 1; d <= maxD; d++) h2.push(d.toString());
        h2.push('', '', '', '', '', '', '');
        aoa.push(h2);

        let grandDays = 0, grandHrs = 0, grandElaun = 0, grandInc = 0, grandSme = 0;
        let dailyActiveHours = Array(maxD).fill(0);
        let rNum = 1;

        activeMems.forEach(m => {
          const stats = calcMemberStats(m.id, st);
          const isNbc = enabledNbcLocs.includes(m.locId);
          const isSme = String(m.sme || '').toUpperCase() === 'YA';
          const incAmount = isNbc ? (stats.incentive || 0) : 0;
          const smeAmount = isSme ? (stats.smeAmount || 0) : 0;
          const totalMember = stats.allowance + incAmount + smeAmount;

          let dailyHours = [];
          for (let d = 1; d <= maxD; d++) {
            const k = `${m.locId}-${m.id}-${st.year}-${st.month}-${d}`;
            const v = st.db.attendance[k] || 'X';
            const h = parseFloat(v);
            if (v !== 'X' && !isNaN(h) && h > 0) {
              dailyHours.push(h);
              dailyActiveHours[d - 1] += h;
            } else {
              dailyHours.push('X');
            }
          }

          let row = [
            rNum++,
            m.nama.toUpperCase(),
            ...dailyHours,
            stats.dys,
            stats.hrs,
            (parseFloat(m.kadar) || 8).toFixed(2),
            formatRM(stats.allowance),
            formatRM(incAmount),
            formatRM(smeAmount),
            formatRM(totalMember)
          ];

          aoa.push(row);
          grandDays += stats.dys;
          grandHrs += stats.hrs;
          grandElaun += stats.allowance;
          grandInc += incAmount;
          grandSme += smeAmount;
