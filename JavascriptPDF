  // Pelaksanaan Janaan PDF Langsung Melalui Handshake
  function executeDirectPDFGeneration(type, previewUrl) {
    const st = window.appState;
    const previewWin = window.open(previewUrl, '_blank');
    if (!previewWin) {
      return alertMsg('Sekatan Pelayar dikesan! Sila benarkan tetingkap timbul bagi melihat laporan.', 'warning');
    }
    showLoading(true);

    let pdfGeneratedData = null;
    let isPreviewReady = false;
    if (window.currentPdfHandshake) {
      window.removeEventListener('message', window.currentPdfHandshake);
      window.currentPdfHandshake = null;
    }

    const handleHandshake = (event) => {
      try {
        const expectedOrigin = new URL(previewUrl).origin;
        if (event.origin !== expectedOrigin) return;
      } catch (err) {
        return;
      }
      
      if (event.data && event.data.type === 'PREVIEW_READY') {
        isPreviewReady = true;
        attemptSend();
      }
    };
    window.currentPdfHandshake = handleHandshake;
    window.addEventListener('message', handleHandshake);

    function attemptSend() {
      if (isPreviewReady && pdfGeneratedData) {
        const targetOrigin = new URL(previewUrl).origin;
        previewWin.postMessage({
          type: 'PDF_DATA',
          data: pdfGeneratedData.uri,
          filename: pdfGeneratedData.filename,
          title: pdfGeneratedData.title
        }, targetOrigin);
        
        window.removeEventListener('message', handleHandshake);
        window.currentPdfHandshake = null;
        showLoading(false);
      }
    }

    setTimeout(() => {
      try {
        const { jsPDF } = window.jspdf;
        const maxD = new Date(st.year, st.month, 0).getDate();
        
        let reportLocIds = [];
        if (st.locId === 'all') {
          if (st.role === 'admin') {
            reportLocIds = st.db.locations.map(l => l.id);
          } else {
            reportLocIds = st.allowedLocs.split(',');
          }
        } else {
          reportLocIds = [st.locId];
        }
        const mems = st.db.members.filter(m => reportLocIds.includes(m.locId));
        let locNameDisplay = "";
        
        if (reportLocIds.length === 1) {
          const lObj = st.db.locations.find(l => l.id === reportLocIds[0]);
          locNameDisplay = lObj ? lObj.name.toUpperCase() : "LOKASI TIDAK DIKETAHUI";
        } else {
          const names = reportLocIds.map(id => st.db.locations.find(x => x.id === id)?.short || id);
          locNameDisplay = `KUMULATIF LOKASI (${names.join(', ')})`;
        }
        
        const reportTitleDate = `01 HINGGA ${maxD} ${M_SHORT[st.month-1].toUpperCase()} ${st.year}`;
        let doc;
        
        const sanitizeFilename = (str) => str.toUpperCase().replace(/[^A-Z0-9]/gi, '_').replace(/_+/g, '_').trim();
        const cleanedLocName = sanitizeFilename(locNameDisplay);
        const cleanedMonthName = sanitizeFilename(M_SHORT[st.month-1]);
        let finalFilename = `Laporan_${type}_${cleanedLocName}_${cleanedMonthName}_${st.year}.pdf`;
        
        const enabledNbcLocs = (st.db.settings.nbc_enabled_locations || '').split(',');
        const anyNbc = reportLocIds.some(id => enabledNbcLocs.includes(id));

        // ======================================================================
        // --- BLOK JANAAN PDF LAMPIRAN B FORMAT BAHARU (TANGKAP LAYAR RASMI) ---
        // ======================================================================
        if (type === 'B') {
          finalFilename = `Rumusan_PTJ_RELA_${cleanedLocName}_${cleanedMonthName}_${st.year}.pdf`;
          let activeMems = mems.filter((m) => calcMemberStats(m.id, st).hrs > 0);
          let grandTotalDays = 0, grandTotalHours = 0, grandTotalAllowance = 0, grandTotalIncentive = 0, grandTotalSme = 0;
          let dailyActiveHours = Array(maxD).fill(0);
          let rNum = 1;

          const memberItems = [];
          activeMems.forEach((m) => {
            const stats = calcMemberStats(m.id, st);
            const isNbcLocation = enabledNbcLocs.includes(m.locId);
            const isSme = String(m.sme || '').toUpperCase() === 'YA';
            const smeAmount = isSme ? (stats.smeAmount || 0) : 0;
            const incAmount = isNbcLocation ? (stats.incentive || 0) : 0;
            const totalAnggota = stats.allowance + incAmount + smeAmount;

            let dailyHoursByDay = [];
            for (let d = 1; d <= maxD; d++) {
              const k = `${m.locId}-${m.id}-${st.year}-${st.month}-${d}`;
              const val = st.db.attendance[k] || 'X';
              const hrs = parseFloat(val);
              if (val !== 'X' && !isNaN(hrs) && hrs > 0) {
                dailyActiveHours[d-1] += hrs;
                dailyHoursByDay.push(hrs.toString());
              } else {
                dailyHoursByDay.push('X');
              }
            }

            let rowNormal = [
              rNum++,
              m.nama.toUpperCase(),
              ...dailyHoursByDay,
              stats.dys,
              stats.hrs,
              (parseFloat(m.kadar) || 8).toFixed(2),
              formatRM(stats.allowance),
              formatRM(incAmount),
              formatRM(smeAmount),
              formatRM(totalAnggota)
            ];

            grandTotalDays += stats.dys;
            grandTotalHours += stats.hrs;
            grandTotalAllowance += stats.allowance;
            grandTotalIncentive += incAmount;
            grandTotalSme += smeAmount;

            let visualLinesCount = 1;
            if ((m.nama || '').trim().length > 25) {
              visualLinesCount = 2;
            }
            memberItems.push({ rows: [rowNormal], heightCount: visualLinesCount });
          });

          function partitionBPage(items, maxNormal, maxFinal, minFinalData) {
            let pages = [];
            let currentChunk = [];
            let currentChunkHeight = 0;
            const rowHt = 4.3;
            for (let i = 0; i < items.length; i++) {
              let item = items[i];
              let itemHeight = item.heightCount * rowHt;
              let remainingItems = items.slice(i + 1);
              let remainingHeight = remainingItems.reduce((s, x) => s + x.heightCount * rowHt, 0);

              if (currentChunkHeight + itemHeight + remainingHeight <= maxFinal) {
                currentChunk.push(item);
                currentChunk.push(...remainingItems);
                pages.push(currentChunk.flatMap(x => x.rows));
                currentChunk = [];
                break;
              }

              if (currentChunkHeight + itemHeight > maxNormal) {
                pages.push(currentChunk.flatMap(x => x.rows));
                currentChunk = [item];
                currentChunkHeight = itemHeight;
              } else {
                if (remainingHeight > 0 && remainingHeight < minFinalData) {
                  pages.push(currentChunk.flatMap(x => x.rows));
                  currentChunk = [item];
                  currentChunkHeight = itemHeight;
                } else {
                  currentChunk.push(item);
                  currentChunkHeight += itemHeight;
                }
              }
            }
            if (currentChunk.length > 0) {
              pages.push(currentChunk.flatMap(x => x.rows));
            }
            return pages;
          }

          let pages = partitionBPage(memberItems, 120, 95, 22);
          const isMultiPage = (pages.length > 1);
          const cellPaddingVal = isMultiPage ? 0.9 : 0.7;
          const fontSizeVal = isMultiPage ? 5.2 : 5.0;
          const signatureSpacing = 10;
          const orphanThreshold = 55;
          const grandTotalAll = grandTotalAllowance + grandTotalIncentive + grandTotalSme;

          // ===================================================================
          // PENYUSUNAN SEMULA BARIS RUMUSAN & JUMLAH KESELURUHAN (KEMAS & KONSISTEN)
          // ===================================================================
          // Baris 1: JUMLAH JAM SEHARI
          let summaryRow1 = [
            { content: 'JUMLAH JAM SEHARI', colSpan: 2, styles: { halign: 'center', fontStyle: 'bold' } }
          ];
          for (let d = 1; d <= maxD; d++) {
            summaryRow1.push(dailyActiveHours[d-1] > 0 ? dailyActiveHours[d-1].toString() : '0');
          }
          summaryRow1.push({ content: 'JUMLAH', colSpan: 3, styles: { halign: 'center', fontStyle: 'bold' } });
          summaryRow1.push({ content: formatRM(grandTotalAllowance), styles: { halign: 'center', fontStyle: 'bold' } });
          summaryRow1.push({ content: formatRM(grandTotalIncentive), styles: { halign: 'center', fontStyle: 'bold' } });
          summaryRow1.push({ content: formatRM(grandTotalSme), styles: { halign: 'center', fontStyle: 'bold' } });
          summaryRow1.push({ content: '', styles: { halign: 'center' } });

          // Baris 2: JUMLAH KESELURUHAN (DITENGAHKAN / CENTERED UNTUK ESTETIKA SEIMBANG & KEMAS)
          let summaryRow2 = [
            { 
              content: 'JUMLAH KESELURUHAN', 
              colSpan: 2 + maxD + 3, 
              styles: { halign: 'center', fontStyle: 'bold', fontSize: 6.5, cellPadding: 1.4 } 
            },
            { 
              content: `RM ${formatRM(grandTotalAll)}`, 
              colSpan: 4, 
              styles: { halign: 'center', fontStyle: 'bold', fontSize: 6.8, textColor: [0, 0, 0], cellPadding: 1.4 } 
            }
          ];

          doc = new jsPDF('l', 'mm', 'a4');
          const totalPagesCount = pages.length;
          pages.forEach((pageRows, pageIndex) => {
            const isFirstPage = (pageIndex === 0);
            const isLastPage = (pageIndex === totalPagesCount - 1);
            if (!isFirstPage) doc.addPage();

            // Pengepala Format Baharu PTJ RELA
            doc.setFont('helvetica', 'bold').setFontSize(9.5).setTextColor(0, 0, 0);
            doc.text('RUMUSAN TUNTUTAN PEMBAYARAN PTJ RELA', 148.5, 12, { align: 'center' });
            doc.setFontSize(8.5);
            doc.text('JABATAN SUKARELAWAN MALAYSIA (RELA)', 148.5, 16.5, { align: 'center' });
            doc.text(`LOKASI PENUGASAN: ${locNameDisplay}`, 148.5, 21, { align: 'center' });
            
            const daerahText = (st.db.settings.report_daerah || 'BATU PAHAT').toUpperCase();
            const bulanNama = M_NAMES[st.month - 1].toUpperCase();
            doc.setFontSize(8);
            doc.text(`DAERAH: ${daerahText} NEGERI: JOHOR BULAN: ${bulanNama} TAHUN: ${st.year}`, 148.5, 25.5, { align: 'center' });

            let headRow1 = [
              { content: 'BIL', rowSpan: 2 },
              { content: 'NAMA PETUGAS', rowSpan: 2 },
              { content: 'TARIKH DAN JUMLAH JAM BERTUGAS (8JAM = 8) (TIDAK BERTUGAS = 0)', colSpan: maxD },
              { content: 'BIL. HARI', rowSpan: 2 },
              { content: 'BIL. JAM', rowSpan: 2 },
              { content: 'KADAR\nTUNTUTAN\nSEJAM (RM)', rowSpan: 2 },
              { content: 'JUMLAH\nELAUN (RM)', rowSpan: 2 },
              { content: 'JUMLAH\nINSENTIF (RM)', rowSpan: 2 },
              { content: 'JUMLAH\nSME (RM)', rowSpan: 2 },
              { content: 'JUMLAH\n(RM)', rowSpan: 2 }
            ];

            let headRow2 = [];
            for (let d = 1; d <= maxD; d++) headRow2.push(d.toString());

            let renderRows = [...pageRows];
            if (isLastPage) {
              renderRows.push(summaryRow1);
              renderRows.push(summaryRow2);
            }

            let colStyles = {
              0: { cellWidth: 8 },
              1: { halign: 'left', cellWidth: 38 },
              [maxD + 2]: { halign: 'center', cellWidth: 10 },
              [maxD + 3]: { halign: 'center', cellWidth: 10 },
              [maxD + 4]: { halign: 'center', cellWidth: 13 },
              [maxD + 5]: { halign: 'center', cellWidth: 15 },
              [maxD + 6]: { halign: 'center', cellWidth: 14 },
              [maxD + 7]: { halign: 'center', cellWidth: 13 },
              [maxD + 8]: { halign: 'center', fontStyle: 'bold', cellWidth: 16 }
            };

            const tableStartY = 28.5;

            doc.autoTable({
              startY: tableStartY,
              head: [headRow1, headRow2],
              body: renderRows,
              theme: 'grid',
              styles: { fontSize: fontSizeVal, cellPadding: cellPaddingVal, halign: 'center', valign: 'middle', lineColor: [0, 0, 0], lineWidth: 0.1, textColor: [0, 0, 0] },
              columnStyles: colStyles,
              headStyles: { fillColor: [248, 250, 252], textColor: [0, 0, 0], fontStyle: 'bold' },
              didParseCell: function (data) {
                if (data.section === 'body' && data.cell.text[0] === 'X') {
                  data.cell.styles.fillColor = [254, 242, 242];
                  data.cell.styles.textColor = [220, 38, 38];
                }
