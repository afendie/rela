  // =========================================================================================
  // --- FUNGSI PEMBANTU (HELPER): PENYELESAIAN SYIF & CAP WAKTU BERTUGAS ---
  // =========================================================================================
  function resolveShiftTimes(m, d, Y, M, st) {
    const k = `${m.locId}-${m.id}-${Y}-${M}-${d}`;
    const attendanceDb = (st.db && st.db.attendance) ? st.db.attendance : {};
    const rosterDb = (st.db && st.db.roster) ? st.db.roster : {};
    
    const attVal = attendanceDb[k] || '';
    const rosterVal = rosterDb[k] || '';
    
    if (!attVal || attVal === 'X' || attVal === 'OFF' || attVal.startsWith('IN:') || attVal.includes('?')) {
      return { masuk: '', keluar: '', jam: '', catatan: '' };
    }
    
    const hrs = parseFloat(attVal);
    if (isNaN(hrs) || hrs <= 0) {
      return { masuk: '', keluar: '', jam: '', catatan: '' };
    }
    
    let masuk = "08:00 PG";
    let keluar = "16:00 PTG";
    let catatan = rosterVal ? `SYIF ${String(rosterVal).toUpperCase()}` : "BERTUGAS";
    
    if (hrs === 12) {
      if (rosterVal === 'PAGI') {
        masuk = "08:00 PG";
        keluar = "20:00 MLM";
      } else if (rosterVal === 'MALAM') {
        masuk = "20:00 MLM";
        keluar = "08:00 PG";
      } else {
        masuk = "08:00 PG";
        keluar = "20:00 MLM";
      }
    } 
    else if (hrs === 9) {
      if (rosterVal === 'PAGI') {
        masuk = "08:00 PG";
        keluar = "17:00 PTG";
      } else if (rosterVal === 'PETANG') {
        masuk = "15:00 PTG";
        keluar = "00:00 MLM";
      } else if (rosterVal === 'MALAM') {
        masuk = "23:00 MLM";
        keluar = "08:00 PG";
      }
    }
    else if (hrs === 8) {
      if (rosterVal === 'PAGI') {
        masuk = "08:00 PG";
        keluar = "16:00 PTG";
      } else if (rosterVal === 'PETANG') {
        masuk = "16:00 PTG";
        keluar = "00:00 MLM";
      } else if (rosterVal === 'MALAM') {
        masuk = "00:00 MLM";
        keluar = "08:00 PG";
      }
    } 
    else {
      masuk = "08:00 PG";
      const endHour = (8 + Math.round(hrs)) % 24;
      const ampm = endHour >= 12 ? (endHour >= 20 ? "MLM" : "PTG") : "PG";
      const displayHr = endHour > 12 ? endHour - 12 : (endHour === 0 ? 12 : endHour);
      keluar = `${String(displayHr).padStart(2, '0')}:00 ${ampm}`;
      catatan = `KERJA LEBIH MASA (${hrs} J)`;
    }
    
    return { masuk, keluar, jam: hrs.toString(), catatan };
  }

