// ======================================================================
// 8. OPERASI PENYIMPANAN KALENDAR MELINTANG (ATTENDANCE & ROSTER)
// ======================================================================
function saveCalendarEntry(mode, flatKey, val) {
  return saveCalendarEntriesBulk(mode, [{ key: flatKey, val: val }]);
}

// ENJIN PENULISAN TARGETED ROW-LEVEL WRITING (MENULIS HANYA BARIS YANG BERUBAH)
function saveCalendarEntriesBulk(mode, updates) {
  const sheetName = mode === 'att' ? 'Attendance' : 'Roster';
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet) return false;

  const lastRow = sheet.getLastRow();
  let values = [];

  // 1. Ambil keseluruhan helaian fizikal ke dalam memori
  if (lastRow > 0) {
    values = sheet.getRange(1, 1, lastRow, 32).getValues();
  } else {
    // Sediakan pengepala standard 32 lajur sekiranya helaian masih kosong
    const daysHeaders = Array.from({ length: 31 }, (_, i) => 'D' + (i + 1));
    values.push(['Kunci Rekod', ...daysHeaders]);
  }

  // 2. Pemetaan indeks baris sedia ada bagi carian pantas O(1)
  const rowMap = {};
  for (let i = 1; i < values.length; i++) {
    rowMap[String(values[i][0]).trim()] = i;
  }

  const modifiedRowIndices = new Set();
  const newRows = [];

  // 3. Gabungkan semua kemaskini kelompok di dalam tatasusunan memori
  updates.forEach(up => {
    const parts = up.key.split('-');
    const len = parts.length;
    if (len < 5) return;

    const day = parseInt(parts[len - 1], 10);
    const month = parts[len - 2];
    const year = parts[len - 3];
    const memId = parts[len - 4];
    const locId = parts.slice(0, len - 4).join('-');

    if (isNaN(day) || day < 1 || day > 31) return;

    const rowKey = `${locId}-${memId}-${year}-${month}`;
    const colIndex = day; // D1 diindeks pada kolum 1, D31 pada kolum 31

    let rowIndex = rowMap[rowKey];
    if (rowIndex === undefined) {
      let tempIdx = newRows.findIndex(r => r[0] === rowKey);
      if (tempIdx === -1) {
        const newRow = Array(32).fill('');
        newRow[0] = rowKey;
        newRow[colIndex] = up.val || '';
        newRows.push(newRow);
      } else {
        newRows[tempIdx][colIndex] = up.val || '';
      }
    } else {
      values[rowIndex][colIndex] = up.val || '';
      modifiedRowIndices.add(rowIndex);
    }
  });

  // 4. Tulis HANYA pada baris-baris sedia ada yang diubah sahaja
  modifiedRowIndices.forEach(idx => {
    sheet.getRange(idx + 1, 1, 1, 32).setValues([values[idx]]);
  });

  // 5. Lampirkan baris-baris baharu sekiranya ada
  if (newRows.length > 0) {
    sheet.getRange(lastRow + 1, 1, newRows.length, 32).setValues(newRows);
  }

  return true;
}
