function saveLocation(l) {
  const formatVal = String(l.format || '8').trim();
  return syncRecord('Locations', 0, l.id, [l.id, l.name, l.short, formatVal]);
}

function deleteLocation(id) {
  return syncRecord('Locations', 0, id, [], true);
}

