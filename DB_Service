// ======================================================================
// 1. MEMBACA & MEMETAKAN DATA DARI GOOGLE SHEETS KE OBJEK JSON
// ======================================================================
function getAppData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const db = { 
    settings: {}, 
    locations: [], 
    supervisors: [], 
    members: [], 
    attendance: {}, 
    roster: {} 
  };

  const readSheet = (name) => {
    const s = ss.getSheetByName(name);
    return s ? s.getDataRange().getValues().slice(1) : [];
  };

  // 1. Baca Tetapan Induk (Settings)
  readSheet('Settings').forEach(r => {
    if (r[0]) {
      db.settings[String(r[0]).trim()] = String(r[1] !== undefined ? r[1] : '').trim();
    }
  });

  // 2. Baca Senarai Cawangan/Lokasi (Locations)
  readSheet('Locations').forEach(r => {
    if (r[0]) {
      db.locations.push({
        id: String(r[0]).trim(),
        name: String(r[1] || '').trim(),
        short: String(r[2] || '').trim(),
        format: String(r[3] || '8').trim()
      });
    }
  });

  // 3. Baca Senarai Penyelia (Supervisors)
  readSheet('Supervisors').forEach(r => {
    if (r[0]) {
      db.supervisors.push({
        id: String(r[0]).trim(),
        name: String(r[1] || '').trim(),
        locId: String(r[2] || '').trim(),
        email: String(r[3] || '').trim(),
        pass: String(r[4] || '').trim()
      });
    }
  });

  // 4. Baca Pangkalan Data Anggota (Members) - Lengkap dengan No Ahli & SME
  readSheet('Members').forEach(r => {
    if (r[0]) {
      db.members.push({
        id: String(r[0]).trim(),
        locId: String(r[1] || '').trim(),
        nama: String(r[2] || '').trim(),
        kp: String(r[3] || '').trim(),
        tel: String(r[4] || '').trim(),
        pangkat: String(r[5] || 'AHLI').trim(),
        kadar: parseFloat(r[6]) || 0,
        bank: String(r[7] || '').trim(),
        akaun: String(r[8] || '').trim(),
        noAhli: String(r[9] || '').trim(),
        sme: String(r[10] || 'TIDAK').trim()
      });
    }
  });

  // 5. ENJIN PARSING MELINTANG: Baca kehadiran (D1 hingga D31) dan petakan ke bentuk flat key
  readSheet('Attendance').forEach(r => {
    const rowKey = String(r[0]).trim();
    if (!rowKey) return;
    for (let d = 1; d <= 31; d++) {
      const val = String(r[d] !== undefined ? r[d] : '').trim();
      if (val !== '') {
        db.attendance[`${rowKey}-${d}`] = val;
      }
    }
  });

  // 6. ENJIN PARSING MELINTANG: Baca jadual syif roster (D1 hingga D31) dan petakan ke bentuk flat key
  readSheet('Roster').forEach(r => {
    const rowKey = String(r[0]).trim();
    if (!rowKey) return;
    for (let d = 1; d <= 31; d++) {
      const val = String(r[d] !== undefined ? r[d] : '').trim();
      if (val !== '') {
        db.roster[`${rowKey}-${d}`] = val;
      }
    }
  });

  return db;
}

// ======================================================================
// 2. MEMBACA NILAI KONFIGURASI TUNGGAL DARI SHEET SETTINGS
// ======================================================================
function getSettingValue_(key) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Settings');
  if (!sheet) return "";
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === key) {
      return String(data[i][1] !== undefined ? data[i][1] : '').trim();
    }
  }
  return "";
}

// ======================================================================
// 3. FUNGSI TRANSAKSIONAL PINTAR (SYNC RECORD: KEMASKINI, TAMBAH, ATAU PADAM)
// ======================================================================
function syncRecord(sheetName, idCol, idVal, rowData, isDelete = false) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet) return false;
  const data = sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {
    if (String(data[i][idCol]).trim() === String(idVal).trim()) {
      if (isDelete) {
        sheet.deleteRow(i + 1);
        return true;
      }
      sheet.getRange(i + 1, 1, 1, rowData.length).setValues([rowData]);
      return true;
    }
  }

  if (!isDelete) {
    sheet.appendRow(rowData);
    return true;
  }
  return false;
}

// ======================================================================
// 4. PENYIMPANAN KONFIGURASI PUKAL (BATCHING WRITE PADA SHEET SETTINGS)
// ======================================================================
function saveSettingsBulk(obj) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Settings');
  if (!sheet) return false;

  const range = sheet.getDataRange();
  const values = range.getValues();
  const mapRows = {};

  // Indeks pemetaan baris berasaskan memori
  for (let i = 1; i < values.length; i++) {
    mapRows[String(values[i][0]).trim()] = i;
  }

  for (let k in obj) {
    const valStr = String(obj[k] !== undefined ? obj[k] : '');
    const rowIndex = mapRows[k];
    if (rowIndex !== undefined) {
      values[rowIndex][1] = valStr;
    } else {
      values.push([k, valStr]);
      mapRows[k] = values.length - 1;
    }
  }

  // Tulis keseluruhan konfigurasi serentak dalam satu transaksi fizikal
  sheet.getRange(1, 1, values.length, 2).setValues(values);
  return true;
}

// ======================================================================
// 5. OPERASI CRUD PANGKALAN ANGGOTA (MEMBERS)
// ======================================================================
function saveMember(m) {
  let kpStr = String(m.kp || '').trim();
  let telStr = String(m.tel || '').trim();
  let akaunStr = String(m.akaun || '').trim();
  let noAhliStr = String(m.noAhli || '').trim();
  let smeStr = String(m.sme || 'TIDAK').toUpperCase().trim();

  // Kekalkan sifar hadapan dan format sengkang secara tegar menggunakan (')
  if (!kpStr.startsWith("'")) kpStr = "'" + kpStr;
  if (!telStr.startsWith("'")) telStr = "'" + telStr;
  if (!akaunStr.startsWith("'")) akaunStr = "'" + akaunStr;
  if (noAhliStr && !noAhliStr.startsWith("'")) noAhliStr = "'" + noAhliStr;

  const rowData = [
    m.id, 
    m.locId, 
    m.nama, 
    kpStr, 
    telStr, 
    m.pangkat, 
    m.kadar, 
    m.bank, 
    akaunStr, 
    noAhliStr, 
    smeStr
  ];

  return syncRecord('Members', 0, m.id, rowData);
}

function deleteMember(id) {
  return syncRecord('Members', 0, id, [], true);
}

function saveMembersBulk(membersArray) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Members');
  if (!sheet) return false;

  const rows = membersArray.map(m => {
    let kpStr = String(m.kp || '').trim();
    let telStr = String(m.tel || '').trim();
    let akaunStr = String(m.akaun || '').trim();
    let noAhliStr = String(m.noAhli || '').trim();
    let smeStr = String(m.sme || 'TIDAK').toUpperCase().trim();

    if (!kpStr.startsWith("'")) kpStr = "'" + kpStr;
    if (!telStr.startsWith("'")) telStr = "'" + telStr;
    if (!akaunStr.startsWith("'")) akaunStr = "'" + akaunStr;
    if (noAhliStr && !noAhliStr.startsWith("'")) noAhliStr = "'" + noAhliStr;

    return [
      m.id, 
      m.locId, 
      m.nama, 
      kpStr, 
      telStr, 
      m.pangkat, 
      m.kadar, 
      m.bank, 
      akaunStr, 
      noAhliStr, 
      smeStr
    ];
  });

  if (rows.length > 0) {
    sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, rows[0].length).setValues(rows);
  }
  return true;
}

