            alertMsg('Ralat: ' + (err.message || err), 'error');
          })
          .changeMyPassword(sessionStorage.getItem('relaToken'), data.oldPass, data.newPass);
      } else {
        showLoading(true);
        st.formModal.open = false;
        alertMsg('Berjaya Tukar Laluan (Mod Demo Offline)', 'success');
      }
    };
    st.formModal.open = true;
  }

  // ==============================================================
  // 5. ATURAN REKA BENTUK ENJIN PAKSA KELUAR & SAPU BERSIH (NEW)
  // ==============================================================
  function forceClockOutJS(key) {
    const st = window.appState;
    const parts = key.split('-');
    if (parts.length < 5) return;
    const memId = parts[1];
    const m = (st.membersMap && st.membersMap[memId]) || st.db.members.find(x => x.id === memId) || { nama: 'Anggota' };
    const locId = parts[0];
    const locObj = st.db.locations.find(l => l.id === locId) || {};
    const defaultFormat = parseFloat(locObj.format || 8);

    Swal.fire({
      title: 'Paksa Log Keluar (Force Clock-Out)?',
      html: `<p class="text-sm font-bold text-slate-700">Tamatkan syif bertugas untuk <b>${m.nama}</b> yang tersangkut.</p>`,
      icon: 'warning',
      input: 'select',
      inputOptions: {
        '4': '4 Jam (Separuh Hari)',
        '8': '8 Jam (Standard)',
        '9': '9 Jam (Operasi Khas)',
        '12': '12 Jam (Kawasan Khas)',
        [defaultFormat.toString()]: `${defaultFormat} Jam (Format Lalai Cawangan)`,
        'OFF': 'OFF / Kosongkan Sesi'
      },
      inputValue: defaultFormat.toString(),
      showCancelButton: true,
      confirmButtonColor: '#f43f5e',
      cancelButtonColor: '#94a3b8',
      confirmButtonText: 'Ya, Tamatkan Sesi',
      cancelButtonText: 'Batal',
      customClass: { popup: 'rounded-3xl' }
    }).then((result) => {
      if (result.isConfirmed) {
        const val = result.value;
        let finalVal = val;
        if (val !== 'OFF' && val !== '') {
          finalVal = val + '|SISTEM: PAKSA KELUAR (LUPA CLOCK-OUT)';
        } else {
          finalVal = ''; // Padam sesi
        }

        showLoading(true);
        if (typeof google !== 'undefined' && google.script) {
          google.script.run
            .withSuccessHandler((res) => {
              showLoading(false);
              if (res && res.success === false) return alertMsg(res.msg, 'error');
              st.syncFromServer(false, true); // Gunakan penyelarasan senyap
              alertMsg('Anggota Berjaya Di-Clock-Out!', 'success');
            })
            .withFailureHandler(err => {
              showLoading(false);
              alertMsg('Ralat: ' + (err.message || err), 'error');
            })
            .saveCalendarEntrySecure(sessionStorage.getItem('relaToken'), 'att', key, finalVal);
        } else {
          showLoading(false);
          if (finalVal === '') delete st.db.attendance[key];
          else st.db.attendance[key] = finalVal;
          st.renderData();
          alertMsg('Clock-out Berjaya (Mod Demo)', 'success');
        }
      }
    });
  }

  // Melaksanakan sapu bersih kelompok menggunakan satu (1) transaksi tunggal (Batch Processing)
  function bulkForceClockOutJS() {
    const st = window.appState;
    const actives = getActiveWorkers(st);
    // Mengesan sesi aktif yang tersangkut melebihi 14 jam (Lupa clock-out)
    const stuck = actives.filter(a => parseFloat(a.hours) > 14);

    if (stuck.length === 0) {
      return Swal.fire({
        title: 'Tiada Sesi Tersangkut',
        text: 'Tiada anggota yang bertugas melebihi 14 jam dikesan saat ini.',
        icon: 'info',
        customClass: { popup: 'rounded-3xl' }
      });
    }

    Swal.fire({
      title: 'Sapu Bersih Sesi Tersangkut?',
      html: `<p class="text-sm font-bold text-slate-700">Sistem mengesan <b>${stuck.length} anggota</b> yang bertugas melebihi 14 jam (lupa clock-out).<br><br>Adakah anda mahu menyelaraskan semua sesi ini secara automatik ke jam syif standard cawangan masing-masing?</p>`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      cancelButtonColor: '#94a3b8',
      confirmButtonText: 'Ya, Sapu Bersih',
      cancelButtonText: 'Batal',
      customClass: { popup: 'rounded-3xl' }
    }).then((result) => {
      if (result.isConfirmed) {
        showLoading(true);
        const keysToReset = stuck.map(item => item.key);

        if (typeof google !== 'undefined' && google.script) {
          google.script.run
            .withSuccessHandler((res) => {
              showLoading(false);
              if (res.success) {
                st.syncFromServer(false, true); // Penyelarasan senyap di latar belakang
                Swal.fire({
                  title: 'Sapu Bersih Selesai!',
                  text: `${res.count} sesi lapor diri yang tersangkut telah berjaya diselaraskan secara kelompok!`,
                  icon: 'success',
                  customClass: { popup: 'rounded-3xl' }
                });
              } else {
                alertMsg(res.msg, 'error');
              }
            })
            .withFailureHandler((err) => {
              showLoading(false);
              alertMsg('Ralat sapu bersih: ' + (err.message || err), 'error');
            })
            .bulkForceClockOutSecure(sessionStorage.getItem('relaToken'), keysToReset);
        } else {
          showLoading(false);
          // Mod Demo offline
          stuck.forEach(item => {
            const locId = item.key.split('-')[0];
            const locObj = st.db.locations.find(l => l.id === locId) || {};
            const defaultFormat = parseFloat(locObj.format || 8);
            st.db.attendance[item.key] = `${defaultFormat}|SISTEM: AUTO-RESET BULK`;
          });
          st.renderData();
          alertMsg('Sapu bersih selesai (Mod Demo)', 'success');
        }
      }
    });
  }
</script>
