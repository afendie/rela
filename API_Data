// ======================================================================
// 8. URUS AKAUN PENYELIA - HAK EKSKLUSIF ADMIN
// ======================================================================
function saveSupervisorSecure(token, s) {
  try {
    const sess = verifySession_(token);
    if (!sess || sess.role !== "admin") return { success: false, msg: "Akses ditolak. Modul ini adalah hak eksklusif Admin." };
    
    // Encrypt kata laluan hanya jika ia dihantar sebagai teks mentah (belum di-hash)
    if (s.pass && s.pass.length < 40) {
      s.pass = sha256_(s.pass);
    }
    saveSupervisor(s);
    return { success: true };
  } catch (err) {
    return { success: false, msg: "Ralat simpan penyelia: " + err.message };
  }
}

function deleteSupervisorSecure(token, id) {
  try {
    const sess = verifySession_(token);
    if (!sess || sess.role !== "admin") return { success: false, msg: "Akses ditolak. Modul ini adalah hak eksklusif Admin." };
    deleteSupervisor(id);
    return { success: true };
  } catch (err) {
    return { success: false, msg: "Ralat padam penyelia: " + err.message };
  }
}

