/**
 * SISTEM PENGURUSAN TUNTUTAN ELAUN RELA - BATU PAHAT
 * Fail: API_QR.gs (Enjin Imbasan QR & Kecerdasan Syif)
 * 
 * Mengelola pemprosesan pengimbasan QR, enjin jendela toleransi hadir lewat/awal,
 * saringan syif lintas hari (cross-day shift), dan verifikasi kelayakan kiosk harian.
 */

// ======================================================================
// FUNGSI PEMBANTU: PENGESAHAN JADUAL ROSTER SEMASA
// ======================================================================
function isScheduledToday_(db, m, klTime) {
  const year = klTime.getFullYear();
  const month = klTime.getMonth() + 1;
  const day = klTime.getDate();

  // Dapatkan tarikh semalam untuk menangani kes syif malam rentas hari (Cross-Day Shift)
  let yesterday = new Date(klTime); 
  yesterday.setDate(klTime.getDate() - 1);
  
  const todayKey = `${m.locId}-${m.id}-${year}-${month}-${day}`;
  const yesterdayKey = `${m.locId}-${m.id}-${yesterday.getFullYear()}-${yesterday.getMonth()+1}-${yesterday.getDate()}`;

  let shiftAssigned = db.roster[todayKey];
  
  // Sokongan Syif Malam Rentas Hari: Semak jika semalam ada syif malam yang bermula
  if (!shiftAssigned || shiftAssigned === 'OFF' || shiftAssigned === 'CUTI' || shiftAssigned === 'X') {
    shiftAssigned = db.roster[yesterdayKey];
    if (shiftAssigned === 'MALAM') {
      shiftAssigned = 'MALAM'; // Izinkan akses keluar (clock-out)
    }
  }

  if (!shiftAssigned || shiftAssigned === 'OFF' || shiftAssigned === 'CUTI' || shiftAssigned === 'X') {
    return false;
  }
  return true;
}

// ======================================================================
// ENJIN GEOLOKASI PINTAR (HAVERSINE DISTANCE & SMART HYBRID GEOFENCING)
// ======================================================================
function calculateDistanceMeters_(lat1, lon1, lat2, lon2) {
  const R = 6371e3; // Radius bumi dalam meter
  const φ1 = lat1 * Math.PI / 180;
  const φ2 = lat2 * Math.PI / 180;
  const Δφ = (lat2 - lat1) * Math.PI / 180;
  const Δλ = (lon2 - lon1) * Math.PI / 180;

  const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
            Math.cos(φ1) * Math.cos(φ2) *
            Math.sin(Δλ/2) * Math.sin(Δλ/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return Math.round(R * c);
}

function verifySmartGeofence_(locObj, clientCoords) {
  // Jika cawangan belum ada tetapan koordinat lat/lng, luluskan automatik (Bebas halangan)
  if (!locObj || !locObj.lat || !locObj.lng || locObj.lat === '' || locObj.lng === '') {
    return { status: 'BYPASS', isOutside: false, note: '' };
  }

  // Jika peranti gagal bekalkan GPS (tiada isyarat satelit / peranti kiosk lama)
  if (!clientCoords || !clientCoords.lat || !clientCoords.lng) {
    return { 
      status: 'NO_GPS', 
      isOutside: true, 
      note: ' [GPS: ISYARAT PERANTI TIDAK DAPAT DIKESAN]' 
    };
  }

  const targetLat = parseFloat(locObj.lat);
  const targetLng = parseFloat(locObj.lng);
  const userLat = parseFloat(clientCoords.lat);
  const userLng = parseFloat(clientCoords.lng);
  const maxRadius = parseFloat(locObj.radius) || 300; // Had lalai 300 meter

  const distance = calculateDistanceMeters_(targetLat, targetLng, userLat, userLng);

  // KES A: Dalam lingkungan had radius pos (Zon Hijau)
  if (distance <= maxRadius) {
    return { status: 'IN_BOUNDS', isOutside: false, distance: distance, note: ` [GPS: SAH DI POS (${distance}m)]` };
  }

  // KES B: Jarak penipuan melampau (Zon Merah > 5 KM - cth berada di rumah/pekan lain)
  if (distance > 5000) {
    const km = (distance / 1000).toFixed(1);
    return { 
      status: 'REJECT_EXTREME', 
      isOutside: true, 
      distance: distance, 
      msg: `PENGESAHAN LOKASI GAGAL!<br><br>Sistem mengesan anda berada sejauh <b>${km} KM</b> daripada pos penugasan rasmi [${locObj.name}]. Sila berada di sekitar pos penugasan.` 
    };
  }

  // KES C: Zon Kuning (Melebihi had radius tetapi di bawah 5 KM - Toleransi GPS telefon lemah di pos pedalaman)
  const kmDist = distance >= 1000 ? `${(distance/1000).toFixed(1)}km` : `${distance}m`;
  return { 
    status: 'OUT_OF_BOUNDS_TOLERATED', 
    isOutside: true, 
    distance: distance, 
    note: ` [GPS: LUAR RADIUS (${kmDist})?]` 
  };
}

// ======================================================================
// ENJIN PEMBUNDARAN PINTAR DENGAN DETEKSI LUPA CLOCK-OUT (AUTO-CAP)
// ======================================================================
function getSmartRoundedHours_(rawHours, defaultFormat) {
  defaultFormat = parseFloat(defaultFormat || 8);
  if (isNaN(defaultFormat) || defaultFormat <= 0) defaultFormat = 8;

  // DETEKSI LUPA CLOCK-OUT: Jika jam bertugas melebihi had munasabah (defaultFormat + 3 jam atau > 14 jam)
  const maxAllowable = Math.max(defaultFormat + 3.0, 14.0);
  if (rawHours > maxAllowable) {
    return {
      hours: defaultFormat,
      note: "SISTEM: AUTO-HAD " + defaultFormat + " JAM (LUPA CLOCK-OUT?)",
      isForcedCap: true
    };
  }

  // Saringan Jendela Syif Pintar Dinamik mengikut defaultFormat cawangan
  const lowerSnap = defaultFormat - 0.7;
  const upperSnap = defaultFormat + 1.2;

  if (rawHours >= lowerSnap && rawHours <= upperSnap) {
    return { 
      hours: defaultFormat, 
      note: "SYIF STANDARD " + defaultFormat + " JAM (AUTO-SNAP PINTAR)",
      isForcedCap: false
    };
  }

  // Snap sekunder bagi syif standard 8 jam jika defaultFormat berbeza
  if (defaultFormat !== 8 && rawHours >= 7.3 && rawHours <= 9.2) {
    return { hours: 8, note: "SYIF STANDARD 8 JAM (AUTO-SNAP PINTAR)", isForcedCap: false };
  }

  // Snap sekunder bagi syif deployment 12 jam jika defaultFormat berbeza
  if (defaultFormat !== 12 && rawHours >= 11.0 && rawHours <= 13.5) {
    return { hours: 12, note: "SYIF DEPLOYMENT 12 JAM (AUTO-SNAP PINTAR)", isForcedCap: false };
  }

  // Pengendalian Kes Lewat Ekstrem Atau Pulang Terlalu Awal
  return { 
    hours: parseFloat(rawHours.toFixed(1)), 
    note: "AMARAN: REKOD DI LUAR JENDELA SYIF NORMAL",
    isForcedCap: false
  };
}

// ======================================================================
// PENGESAHAN KELAYAKAN KIOSK (GATEKEEPER SEBELUM JANAAN QR)
// ======================================================================
function checkKioskEligibility(kpRaw) {
  const db = getAppData(); 
  const cleanKp = String(kpRaw).trim().replace(/'/g, '');

  // Saring senarai profil anggota menggunakan No Kad Pengenalan
  const matchingMembers = db.members.filter(x => x.id === cleanKp || String(x.kp).replace(/'/g, '') === cleanKp);
  if(matchingMembers.length === 0) {
    return { success: false, msg: "Ralat: No. Kad Pengenalan tidak wujud dalam sistem. Sila hubungi Pentadbir." };
  }

  // Sentiasa gunakan Zon Waktu Standard Kuala Lumpur (Johor) secara tegar
  const klTimeStr = new Date().toLocaleString("en-US", {timeZone: "Asia/Kuala_Lumpur"});
  const klTime = new Date(klTimeStr);

  // Cari profil penugasan cawangan mana yang mempunyai jadual aktif hari ini
  let m = matchingMembers.find(member => isScheduledToday_(db, member, klTime));
  if (!m) {
    m = matchingMembers[0];
    return { success: false, msg: `Maaf <b>${m.nama}</b>,<br>Sistem mendapati anda <b>TIDAK DIJADUALKAN BERTUGAS</b> di mana-mana cawangan hari ini. Akses modul operasi disekat.` };
  }
  
  return { success: true, name: m.nama, kp: cleanKp };
}

// ======================================================================
// ENJIN PROSES IMBASAN QR (REAL-TIME SMART SCANNER ENGINE)
// ======================================================================
function processQRScan(data) {
  try {
    const db = getAppData();
    const nowMs = Date.now();
    const klTimeStr = new Date().toLocaleString("en-US", {timeZone: "Asia/Kuala_Lumpur"});
    const klTime = new Date(klTimeStr);
    const coords = data.coords || null; // Ambil koordinat GPS daripada peranti
    
    const getKey = (dateObj, m) => `${m.locId}-${m.id}-${dateObj.getFullYear()}-${dateObj.getMonth()+1}-${dateObj.getDate()}`;

    // KES 1: Log Masuk Kiosk (Clock-in Sahaja)
    if (data.action === 'clockin_only') {
      const cleanKp = String(data.scannerId).trim().replace(/'/g, '');
      const matchingIn = db.members.filter(x => x.id === cleanKp || String(x.kp).replace(/'/g, '') === cleanKp);
      if (matchingIn.length === 0) return { success: false, msg: "KP Anggota tidak ditemui." };
      
      let mIn = matchingIn.find(x => isScheduledToday_(db, x, klTime));
      if (!mIn) return { success: false, msg: `Akses disekat! Anda tidak mempunyai jadual bertugas aktif hari ini.` };

      // Semakan Geofencing Pintar Lokasi
      const locObj = db.locations.find(l => l.id === mIn.locId) || {};
      const geoCheck = verifySmartGeofence_(locObj, coords);
      if (geoCheck.status === 'REJECT_EXTREME') {
        return { success: false, msg: geoCheck.msg };
      }

      const targetKey = getKey(klTime, mIn);
      const existingVal = db.attendance[targetKey] || '';
      if (existingVal.startsWith('IN:')) return { success: false, msg: "Anda sudah pun melapor masuk dan SEDANG BERTUGAS." };

      saveCalendarEntry('att', targetKey, `IN:${nowMs}`);
      let successMsg = `Lapor Masuk Berjaya! Status: SEDANG BERTUGAS di cawangan [${mIn.locId}].`;
      if (geoCheck.note) successMsg += `<br><span class="text-[9px] text-slate-500 font-bold">${geoCheck.note}</span>`;
      return { success: true, msg: successMsg, memName: mIn.nama };
    }

    // KES 2: Log Keluar Kiosk (Clock-out Sahaja)
    if (data.action === 'checkout_only') {
      const cleanKp = String(data.scannerId).trim().replace(/'/g, '');
      const matchingOut = db.members.filter(x => x.id === cleanKp || String(x.kp).replace(/'/g, '') === cleanKp);
      if (matchingOut.length === 0) return { success: false, msg: "KP Anggota tidak ditemui." };

      let mOut = null;
      let targetKeyOut = "";
      let valOut = "";

      for (let currentProfile of matchingOut) {
        let checkKey = getKey(klTime, currentProfile);
        let checkVal = db.attendance[checkKey] || '';
        
        if (checkVal.startsWith('IN:')) {
          mOut = currentProfile;
          targetKeyOut = checkKey;
          valOut = checkVal;
          break;
        }
        
        let yesterday = new Date(klTime); yesterday.setDate(klTime.getDate() - 1);
        let checkKeyYest = getKey(yesterday, currentProfile);
        let checkValYest = db.attendance[checkKeyYest] || '';
        if (checkValYest.startsWith('IN:')) {
          mOut = currentProfile;
          targetKeyOut = checkKeyYest;
          valOut = checkValYest;
          break;
        }
      }

      if (!mOut) {
        mOut = matchingOut.find(x => isScheduledToday_(db, x, klTime));
        if (!mOut) mOut = matchingOut[0];
        targetKeyOut = getKey(klTime, mOut);
        valOut = db.attendance[targetKeyOut] || '';
      }

      if (!valOut.startsWith('IN:') && !isScheduledToday_(db, mOut, klTime)) {
        return { success: false, msg: `Akses ditolak! Tiada sesi tugas aktif dan tiada jadual ditemui hari ini.` };
      }

      const locObj = db.locations.find(l => l.id === mOut.locId) || {};
      const geoCheck = verifySmartGeofence_(locObj, coords);
      if (geoCheck.status === 'REJECT_EXTREME') {
        return { success: false, msg: geoCheck.msg };
      }

      let calculated = { hours: 0, note: "REKOD MANUAL PENYELIA" };
      const defaultFormat = parseFloat(locObj.format || 8);

      if (valOut.startsWith('IN:')) {
        const inMs = parseInt(valOut.replace('IN:', ''), 10);
        const diffHours = (nowMs - inMs) / 3600000;
        calculated = getSmartRoundedHours_(diffHours, defaultFormat);
      } else {
        return { success: false, msg: "RALAT: Tiada rekod Lapor Masuk (IN) ditemui. Sila hubungi Penyelia." };
      }

      // Jika auto-cap ATAU berada di luar had geofence bertoleransi, minta pengesahan penyelia (?)
      let needsApproval = calculated.isForcedCap || geoCheck.isOutside || (calculated.hours !== defaultFormat && calculated.hours !== 8 && calculated.hours !== 12);
      let combinedNote = calculated.note + (geoCheck.note || '');

      let finalPayload = needsApproval
        ? `${calculated.hours}?|${combinedNote}`
        : `${calculated.hours}|${combinedNote}`;

      saveCalendarEntry('att', targetKeyOut, finalPayload);
      return { 
        success: true, 
        msg: `Tamat Tugas cawangan [${mOut.locId}] (${calculated.hours} Jam) direkodkan.${needsApproval ? ' Menunggu Pengesahan Penyelia.' : ''}`, 
        memName: mOut.nama 
      };
    }

    // KES 3: Log Scan QR Pas Pasukan (Serah Tugas Syif - Handshake Protocol)
    const parts = String(data.scannedData).trim().split('|');
    if (parts.length < 2) return { success: false, msg: "Kod QR tidak sah." };

    const kpRaw = parts[0].replace(/'/g, '');
    const qrTimestamp = parseInt(parts[1], 10);
    if (isNaN(qrTimestamp) || (nowMs - qrTimestamp) > 45000) {
      return { success: false, msg: "Kod QR telah luput (Maksimum 45 saat untuk keselamatan)." };
    }

    const matchingOut = db.members.filter(x => x.id === kpRaw || String(x.kp).replace(/'/g, '') === kpRaw);
    if(matchingOut.length === 0) return { success: false, msg: "Rekod anggota KELUAR tidak ditemui." };

    let mOut = matchingOut.find(x => {
      let tk = getKey(klTime, x);
      if ((db.attendance[tk] || '').startsWith('IN:')) return true;
      let yest = new Date(klTime); yest.setDate(klTime.getDate() - 1);
      if ((db.attendance[getKey(yest, x)] || '').startsWith('IN:')) return true;
      return false;
    }) || matchingOut.find(x => isScheduledToday_(db, x, klTime)) || matchingOut[0];

    const scannerKpClean = String(data.scannerId).trim().replace(/'/g, '');
    const matchingIn = db.members.filter(x => x.id === scannerKpClean || String(x.kp).replace(/'/g, '') === scannerKpClean);
    if (data.token === 'KIOSK_MODE' && matchingIn.length === 0) {
      return { success: false, msg: "ID Rakan Pengganti (Tukang Imbas) tidak dijumpai." };
    }

    let mIn = matchingIn.find(x => x.locId === mOut.locId && isScheduledToday_(db, x, klTime)) || 
              matchingIn.find(x => isScheduledToday_(db, x, klTime)) || 
              matchingIn[0];

    if (mIn && !isScheduledToday_(db, mIn, klTime)) {
      return { success: false, msg: `Akses ditolak! Rakan pengganti (${mIn.nama}) tidak dijadualkan bertugas hari ini.` };
    }

    // Semakan Geofence untuk Handshake
    const locObj = db.locations.find(l => l.id === mOut.locId) || {};
    const geoCheck = verifySmartGeofence_(locObj, coords);
    if (geoCheck.status === 'REJECT_EXTREME') {
      return { success: false, msg: geoCheck.msg };
    }

    let targetKeyOut = getKey(klTime, mOut);
    let valOut = db.attendance[targetKeyOut] || '';
    if (!valOut.startsWith('IN:')) {
      let yesterday = new Date(klTime); yesterday.setDate(klTime.getDate() - 1);
      const yesterdayKey = getKey(yesterday, mOut);
      if ((db.attendance[yesterdayKey] || '').startsWith('IN:')) { 
        targetKeyOut = yesterdayKey; 
        valOut = db.attendance[yesterdayKey]; 
      }
    }

    const defaultFormat = parseFloat(locObj.format || 8);
    let calculated = { hours: defaultFormat, note: "SERAH TUGAS OPERASI (HANDSHAKE)" };

    if (valOut.startsWith('IN:')) {
      const inMs = parseInt(valOut.replace('IN:', ''), 10);
      const diffHours = (nowMs - inMs) / 3600000;
      calculated = getSmartRoundedHours_(diffHours, defaultFormat);
    } else {
      calculated.hours = defaultFormat;
    }

    let needsApproval = calculated.isForcedCap || geoCheck.isOutside || (calculated.hours !== defaultFormat && calculated.hours !== 8 && calculated.hours !== 12);
    let combinedNote = calculated.note + (geoCheck.note || '');

    let finalPayload = needsApproval
      ? `${calculated.hours}?|${combinedNote}`
      : `${calculated.hours}|${combinedNote}`;

    saveCalendarEntry('att', targetKeyOut, finalPayload);

    if (mIn) {
      const targetKeyIn = getKey(klTime, mIn);
      saveCalendarEntry('att', targetKeyIn, `IN:${nowMs}`);
    }

    let finalMsg = `Serah tugas [${mOut.locId}] selesai. Kehadiran ${mOut.nama} disahkan (${calculated.hours} Jam).`;
    if (mIn) finalMsg += `\n> ${mIn.nama} mula bertugas (Lapor Masuk).`;
    if (geoCheck.note) finalMsg += `<br><span class="text-[9px] text-slate-500 font-bold">${geoCheck.note}</span>`;

    return { success: true, msg: finalMsg, memName: mOut.nama };
  } catch (err) {
    return { success: false, msg: "Ralat pemprosesan QR: " + err.message };
  }
}

// ======================================================================
// FUNGSI SIMULASI UJI CUBA QR (TEST HARNESS UNTUK GOOGLE APPS SCRIPT)
// ======================================================================
/**
 * Jalankan fungsi ini terus di Google Apps Script Editor untuk menguji proses QR tanpa kamera.
 * Anda boleh menukar nombor KP di bawah dengan No KP anggota sebenar yang ada jadual tugas hari ini.
 */
function testQRSimulation() {
  const db = getAppData();
  if (!db.members || db.members.length === 0) {
    Logger.log("RALAT: Tiada anggota didaftarkan di dalam tab Members.");
    return;
  }

  // Pilih anggota pertama sebagai sampel ujian
  const testMember = db.members[0];
  const cleanKp = String(testMember.kp).replace(/'/g, '');

  Logger.log("=== 1. UJIAN SEMAKAN KELAYAKAN KIOSK ===");
  const checkRes = checkKioskEligibility(cleanKp);
  Logger.log(JSON.stringify(checkRes, null, 2));

  Logger.log("\n=== 2. UJIAN CLOCK-IN KIOSK ===");
  const clockInPayload = {
    action: 'clockin_only',
    scannerId: cleanKp,
    coords: { lat: 1.854321, lng: 102.932456 }
  };
  const clockInRes = processQRScan(clockInPayload);
  Logger.log(JSON.stringify(clockInRes, null, 2));

  Logger.log("\n=== 3. UJIAN CLOCK-OUT KIOSK ===");
  const clockOutPayload = {
    action: 'checkout_only',
    scannerId: cleanKp,
    coords: { lat: 1.854321, lng: 102.932456 }
  };
  const clockOutRes = processQRScan(clockOutPayload);
  Logger.log(JSON.stringify(clockOutRes, null, 2));
}
