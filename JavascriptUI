               st.db.supervisors = st.db.supervisors.filter(x=>x.id!==id);
              st.renderData();
              st.syncFromServer(false, true); // Silent background sync
              alertMsg('Penyelia dipadam.');
             } else alertMsg(res.msg, 'error');
           }).withFailureHandler(err => { showLoading(false); alertMsg('Ralat: ' + err.message, 'error'); }).deleteSupervisorSecure(sessionStorage.getItem('relaToken'), id);
        } else { showLoading(false); st.db.supervisors = st.db.supervisors.filter(x=>x.id!==id); st.renderData(); alertMsg('Penyelia dipadam.'); }
      }
    });
  }

