            <button onclick="processRosterUploadJS()" class="w-1/2 py-4 bg-slate-800 text-white rounded-2xl font-black text-xs uppercase tracking-widest active:scale-95 transition-all">Saring Fail</button>
            <button id="btn-roster-execute" onclick="executeRosterImportJS()" disabled class="w-1/2 py-4 bg-slate-300 text-slate-500 rounded-2xl font-black text-xs uppercase tracking-widest cursor-not-allowed transition-all">Import</button>
          </div>
