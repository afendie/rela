  function downloadRosterTemplateJS() {
    const st = window.appState;
    const maxD = new Date(st.year, st.month, 0).getDate();
    let mems = st.getFilteredMems();
    
    let aoa = [];
    let header = ['NAMA PETUGAS', 'NO KP (JANGAN UBAH)'];
    for(let d=1; d<=maxD; d++) header.push(d.toString());
    aoa.push(header);
    mems.forEach(m => {
      let row = [m.nama, m.kp];
      for(let d=1; d<=maxD; d++) {
          row.push(st.db.roster[`${m.locId}-${m.id}-${st.year}-${st.month}-${d}`] || '');
      }
      aoa.push(row);
    });
    const ws = XLSX.utils.aoa_to_sheet(aoa);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Templat Jadual");
    XLSX.writeFile(wb, `Templat_Jadual_${st.locId === 'all' ? 'SEMUA' : st.locId}_${M_SHORT[st.month-1]}_${st.year}.xlsx`);
  }

  function processRosterUploadJS() {
    const fileInput = document.getElementById('roster-upload-file');
    if (!fileInput.files || fileInput.files.length === 0) return alertMsg('Sila muat naik fail Excel terlebih dahulu.', 'warning');
    
    showLoading(true);
    const file = fileInput.files[0];
    const reader = new FileReader();
    
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const wb = XLSX.read(data, {type: 'array'});
            const ws = wb.Sheets[wb.SheetNames[0]];
            const json = XLSX.utils.sheet_to_json(ws, {header: 1});
            
            const st = window.appState;
            const maxD = new Date(st.year, st.month, 0).getDate();
            tempRosterImportQueue = [];
            let validCount = 0;
            
            for (let i = 1; i < json.length; i++) {
                const row = json[i];
                if (!row || row.length < 2) continue;
                let rawKp = String(row[1] || '').replace(/[^0-9]/g, '');
                if (rawKp.length !== 12) continue;
                
                const mem = st.db.members.find(x => String(x.kp).replace(/[^0-9]/g, '') === rawKp);
                if (!mem) continue;
                
                const allowed = st.role === 'admin' ? true : st.allowedLocs.split(',').includes(mem.locId);
                if (!allowed) continue;
                for (let d = 1; d <= maxD; d++) {
                    let val = String(row[d+1] || '').toUpperCase().trim();
                    let normalized = null;
                    
                    if(['PAGI', 'P'].includes(val)) normalized = 'PAGI';
                    else if(['PETANG', 'PTG', 'PT'].includes(val)) normalized = 'PETANG';
                    else if(['MALAM', 'M'].includes(val)) normalized = 'MALAM';
                    else if(['OFF', 'O', 'CUTI', 'X'].includes(val)) normalized = 'OFF';
                    else if(val === '') normalized = '';
                    
                    if(normalized !== null) {
                        const k = `${mem.locId}-${mem.id}-${st.year}-${st.month}-${d}`;
                        tempRosterImportQueue.push({key: k, val: normalized});
                        validCount++;
                    }
                }
            }
            
            showLoading(false);
            const sumBox = document.getElementById('roster-preflight-summary');
            if (validCount === 0) {
                sumBox.className = "p-4 bg-rose-50 border border-rose-150 rounded-2xl text-left mt-4 block";
                sumBox.innerHTML = `<p class="text-[10px] text-rose-600 font-bold"><i class="fas fa-exclamation-circle mr-1"></i> Tiada data jadual sah dijumpai. Pastikan anda menggunakan format templat yang betul.</p>`;
            } else {
                sumBox.className = "p-4 bg-emerald-50 border border-emerald-150 rounded-2xl text-left mt-4 block";
                sumBox.innerHTML = `<p class="text-[10px] text-emerald-700 font-bold"><i class="fas fa-check-circle mr-1"></i> Format disahkan! Sebanyak ${validCount} plot jadual (termasuk kosong) sedia untuk dimasukkan.</p>`;
                const btn = document.getElementById('btn-roster-execute');
                btn.disabled = false;
                btn.className = "w-1/2 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl active:scale-95 cursor-pointer transition-all";
            }
        } catch(err) {
            showLoading(false);
            console.error(err);
            alertMsg('Gagal membaca format Excel.', 'error');
        }
    };
    reader.readAsArrayBuffer(file);
  }

  // Ditambah sokongan silent sync pasca import roster
  function executeRosterImportJS() {
    if(tempRosterImportQueue.length === 0) return;
    const st = window.appState;
    showLoading(true);
    if(typeof google !== 'undefined' && google.script) {
      google.script.run.withSuccessHandler((res) => {
          showLoading(false);
          if (res.success) {
            st.formModal.open = false;
            st.syncFromServer(false, true); // SILENT BACKGROUND SYNC
            Swal.fire({ title: 'Import Selesai!', text: `Sejumlah ${res.count} sel jadual berjaya didaftarkan.`, icon: 'success', customClass: { popup: 'rounded-3xl' } });
            tempRosterImportQueue = [];
          } else {
            alertMsg(res.msg, 'error');
          }
       }).withFailureHandler(err => {
          showLoading(false);
          alertMsg('Ralat Import Roster: ' + err.message, 'error');
       }).importRosterBulkSecure(sessionStorage.getItem('relaToken'), tempRosterImportQueue);
    } else {
      showLoading(false);
      st.formModal.open = false;
      // Mod Demo
      tempRosterImportQueue.forEach(item => {
          if(item.val === '') delete st.db.roster[item.key];
          else st.db.roster[item.key] = item.val;
      });
      st.renderData();
      alertMsg('Jadual Diimport (Mod Demo)');
      tempRosterImportQueue = [];
    }
  }
