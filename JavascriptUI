      const badge = document.getElementById('kp-detected-badge');
      if (clean.length === 12) {
        const found = st.db.members.find(x => String(x.kp).replace(/[^0-9]/g, '').trim() === clean);
        if (found) {
          const form = document.getElementById('f-member');
          if (form) {
            if (!form.nama.value) form.nama.value = found.nama || '';
            if (!form.tel.value) form.tel.value = found.tel || '';
            if (form.noAhli && !form.noAhli.value) form.noAhli.value = found.noAhli || '';
            if (form.sme) form.sme.value = found.sme || 'TIDAK';
            if (form.pangkat) form.pangkat.value = found.pangkat || 'AHLI';
            if (form.kadar && (!form.kadar.value || form.kadar.value == 8)) form.kadar.value = found.kadar || 8;
            if (form.bank) form.bank.value = found.bank || 'MAYBANK';
            if (!form.akaun.value) form.akaun.value = found.akaun || '';
          }
          if (badge) badge.classList.remove('hidden');
          return;
        }
      }
      if (badge) badge.classList.add('hidden');
