  let tempRosterImportQueue = [];
  function openImportRosterModalJS() {
    const st = window.appState;
    st.formModal.title = 'Import Jadual Syif (Excel)';
    document.getElementById('form-body-inject').innerHTML = `
      <div class="space-y-6 page-transition text-center">
          <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-2xl">
