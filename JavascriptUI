        mObj.kadar = parseFloat(mObj.kadar) || 8;
        mObj.kp = String(mObj.kp).replace(/[^0-9]/g, '').trim(); 
        mObj.tel = String(mObj.tel).replace(/[^0-9]/g, '').trim(); 
        mObj.akaun = String(mObj.akaun).replace(/[^0-9]/g, '').trim();
        mObj.noAhli = String(mObj.noAhli || '').trim();
        mObj.sme = String(mObj.sme || 'TIDAK').toUpperCase();

        if (mObj.kp.length !== 12) return alertMsg('Sila isi No KP 12 digit yang sah tanpa sengkang.', 'warning');
        
        // PINTAR: Semak duplikasi HANYA jika anggota sudah didaftarkan pada CAWANGAN YANG SAMA
        const isDuplicateInSameLoc = st.db.members.some(x => 
          String(x.kp).replace(/'/g, '').trim() === mObj.kp && x.locId === mObj.locId && x.id !== mObj.id
        );
        if (isDuplicateInSameLoc) {
          return alertMsg('Anggota ini sudah pun berdaftar di cawangan ini! Tidak boleh bertindih di lokasi yang sama.', 'error');
        }

        showLoading(true);
        if(typeof google !== 'undefined' && google.script) {
          google.script.run.withSuccessHandler((res) => {
             showLoading(false);
             if (res.success) {
               st.formModal.open = false;
               // Kemaskini visual senarai serta-merta
              if (isNew) st.db.members.push(mObj);
              else {
                const idx = st.db.members.findIndex(x => x.id === mObj.id);
                if (idx !== -1) st.db.members[idx] = mObj;
              }
              st.renderData();
              st.syncFromServer(false, true); // Silent background sync untuk data pangkalan
              Swal.fire({ title: 'Berjaya!', text: 'Profil Anggota berjaya dikemaskini.', icon: 'success', customClass: { popup: 'rounded-3xl' } });
             } else {
               alertMsg(res.msg, 'error');
             }
           }).withFailureHandler(err => {
             showLoading(false);
             alertMsg('Ralat: ' + err.message, 'error');
           }).saveMemberSecure(sessionStorage.getItem('relaToken'), mObj);
        } else {
          showLoading(false); st.formModal.open = false; if(isNew) st.db.members.push(mObj); else { const idx = st.db.members.findIndex(x => x.id === mObj.id); if(idx !== -1) st.db.members[idx] = mObj; } st.renderData(); alertMsg('Disimpan (Mod Demo)');
