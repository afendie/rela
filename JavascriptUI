<script>
  // ==============================================================
  // 1. ENJIN REKA BENTUK HTML & KOMPONEN DINAMIK (VANILLA RENDERING)
  // ==============================================================
  function renderActivePageHTML(state) {
    const c = document.getElementById('page-content');
    if (!c) return;
    c.innerHTML = '';
    const mems = state.getFilteredMems();
    
    /* Membina objek cache pengiraan dan Map pendaftaran O(1) bagi mengelakkan ralat perlumbaan memori */
    state.statsCache = {};
    state.membersMap = {};
    if (state.db && state.db.members) {
      state.db.members.forEach(m => {
        state.membersMap[m.id] = m;
      });
    }
    
    // Pra-proses semua data tetapan sistem di luar gelung utama
    let customRates = {};
    let nbcCustomRates = {};
    try {
      customRates = JSON.parse(state.db.settings.ot_custom_rates_json || '{}');
    } catch(e) {
      console.error("Gagal parse ot_custom_rates_json", e);
    }
    try {
      nbcCustomRates = JSON.parse(state.db.settings.nbc_custom_rates_json || '{}');
    } catch(e) {
      console.error("Gagal parse nbc_custom_rates_json", e);
    }

    state.parsedSettings = {
      otActive: state.db.settings.ot_rule_active === 'true',
      otMaxHrs: parseFloat(state.db.settings.ot_normal_max_hrs || 8),
      otRate: parseFloat(state.db.settings.ot_rate_per_hr || 8.00),
      dailyIncRate: parseFloat(state.db.settings.nbc_incentive_rate || 30.00),
      smeRate: parseFloat(state.db.settings.sme_rate_per_hr || 1.00),
      otLocs: (state.db.settings.ot_enabled_locations || '').split(','),
      enabledLocs: (state.db.settings.nbc_enabled_locations || '').split(','),
      smeLocs: (state.db.settings.sme_enabled_locations || '').split(','),
      otCustomRates: customRates,
      nbcCustomRates: nbcCustomRates
    };
    
    switch(state.page) {
      case 'dashboard': buildDashboard(c, mems, state); break;
      case 'attendance': buildAttendance(c, mems, state); break;
      case 'roster': buildRoster(c, mems, state); break;
      case 'staff': buildStaff(c, mems, state); break;
      case 'reports': buildReports(c, state); break;
      case 'settings': buildSettings(c, state); break;
    }
  }

  // Escape attributes helper global
  const escapeAttrGlobal = (val) => String(val || '').replace(/"/g, '&quot;');

  // ==============================================================
  // ENJIN STRUKTUR ATURAN OT PINTAR CAWANGAN (FUTURISTIC CONFIG MATRIX)
  // ==============================================================
  window.tempOtCustomRates = {};
  window.tempNbcCustomRates = {};

  function initOtLocationConfigJS(state) {
    try {
      window.tempOtCustomRates = JSON.parse(state.db.settings.ot_custom_rates_json || '{}');
    } catch(e) {
      window.tempOtCustomRates = {};
    }
    try {
      window.tempNbcCustomRates = JSON.parse(state.db.settings.nbc_custom_rates_json || '{}');
    } catch(e) {
      window.tempNbcCustomRates = {};
    }
  }

  // ==============================================================
  // FUNGSI PENGENDALI INSENTIF PINTAR MENGIKUT LOKASI
  // ==============================================================
  window.toggleNbcLocationJS = function(locId, isChecked) {
    const rateInputContainer = document.getElementById(`nbc-rate-box-${locId}`);
    if (rateInputContainer) {
      if (isChecked) rateInputContainer.classList.remove('hidden');
      else rateInputContainer.classList.add('hidden');
    }
    if (isChecked) {
      if (window.tempNbcCustomRates[locId] === undefined) {
        const defaultRate = window.appState.db.settings.nbc_incentive_rate || '30.00';
        window.tempNbcCustomRates[locId] = parseFloat(defaultRate);
      }
    } else {
      delete window.tempNbcCustomRates[locId];
    }
    serializeNbcCustomRatesJS();
  };

  window.updateNbcRateValJS = function(locId, val) {
    const rate = parseFloat(val);
    window.tempNbcCustomRates[locId] = isNaN(rate) ? 0 : rate;
    serializeNbcCustomRatesJS();
  };

  window.serializeNbcCustomRatesJS = function() {
    const hiddenInput = document.getElementById('nbc-custom-rates-json-hidden');
    if (hiddenInput) {
      hiddenInput.value = JSON.stringify(window.tempNbcCustomRates);
    }
  };

  function renderNbcLocationSelectors(state) {
    const s = state.db.settings;
    let nbcCustomRates = {};
    try {
      nbcCustomRates = JSON.parse(s.nbc_custom_rates_json || '{}');
    } catch(e) {
      nbcCustomRates = {};
    }

    const nbcEnabledArr = (s.nbc_enabled_locations || '').split(',');
    const defaultRate = s.nbc_incentive_rate || '30.00';

    return state.db.locations.map(l => {
      const isChecked = nbcEnabledArr.includes(l.id) ? 'checked' : '';
      const currentRate = (nbcCustomRates[l.id] !== undefined) ? nbcCustomRates[l.id] : defaultRate;

      return `
        <div class="p-3.5 bg-white border border-slate-150 rounded-2xl shadow-xs transition-all hover:border-emerald-300">
          <div class="flex items-center justify-between gap-3">
            <label class="flex items-center gap-3 cursor-pointer flex-1 min-w-0">
              <input type="checkbox" name="nbc_loc_${l.id}" value="${l.id}" ${isChecked} onchange="toggleNbcLocationJS('${l.id}', this.checked)" class="w-4 h-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500">
              <span class="text-xs font-black text-slate-800 uppercase truncate">[${l.short}] ${l.name}</span>
            </label>
            <div id="nbc-rate-box-${l.id}" class="${isChecked ? '' : 'hidden'} flex items-center gap-1.5 shrink-0 bg-emerald-50 px-2.5 py-1 rounded-xl border border-emerald-100">
              <span class="text-[9px] font-black text-emerald-700">RM</span>
              <input type="number" step="1" min="0" value="${currentRate}" onchange="updateNbcRateValJS('${l.id}', this.value)" class="w-16 px-2 py-0.5 bg-white border border-emerald-200 rounded-lg text-xs font-black text-center text-emerald-800 outline-none focus:ring-2 focus:ring-emerald-400">
              <span class="text-[8px] font-bold text-emerald-600 uppercase">/Hari</span>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  window.toggleOtLocationJS = function(locId, isChecked) {
    const panel = document.getElementById(`ot-config-panel-${locId}`);
    if (panel) {
      if (isChecked) panel.classList.remove('hidden');
      else panel.classList.add('hidden');
    }
    if (isChecked && !window.tempOtCustomRates[locId]) {
      window.tempOtCustomRates[locId] = {
        type: 'flat',
        flatRate: window.appState.db.settings.ot_rate_per_hr || '8.00',
        ranks: { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' }
      };
    }
    serializeOtCustomRatesJS();
  };

  window.changeOtConfigTypeJS = function(locId, type) {
    if (!window.tempOtCustomRates[locId]) {
      window.tempOtCustomRates[locId] = { type: 'flat', flatRate: '8.00', ranks: { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' } };
    }
    window.tempOtCustomRates[locId].type = type;
    
    const flatPanel = document.getElementById(`panel-ot-flat-${locId}`);
    const rankPanel = document.getElementById(`panel-ot-rank-${locId}`);
    if (type === 'flat') {
      flatPanel.classList.remove('hidden');
      rankPanel.classList.add('hidden');
    } else {
      flatPanel.classList.add('hidden');
      rankPanel.classList.remove('hidden');
    }
    serializeOtCustomRatesJS();
  };

  window.updateOtConfigValJS = function(locId, key, val) {
    if (!window.tempOtCustomRates[locId]) {
      window.tempOtCustomRates[locId] = { type: 'flat', flatRate: '8.00', ranks: { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' } };
    }
    window.tempOtCustomRates[locId][key] = val;
    serializeOtCustomRatesJS();
  };

  window.updateOtConfigRankValJS = function(locId, rank, val) {
    if (!window.tempOtCustomRates[locId]) {
      window.tempOtCustomRates[locId] = { type: 'rank', flatRate: '8.00', ranks: { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' } };
    }
    if (!window.tempOtCustomRates[locId].ranks) {
      window.tempOtCustomRates[locId].ranks = { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' };
    }
    window.tempOtCustomRates[locId].ranks[rank] = val;
    serializeOtCustomRatesJS();
  };

  window.serializeOtCustomRatesJS = function() {
    const hiddenInput = document.getElementById('ot-custom-rates-json-hidden');
    if (hiddenInput) {
      hiddenInput.value = JSON.stringify(window.tempOtCustomRates);
    }
  };

  function renderOtLocationSelectors(state) {
    const s = state.db.settings;
    let customRates = {};
    try {
      customRates = JSON.parse(s.ot_custom_rates_json || '{}');
    } catch(e) {
      customRates = {};
    }
    
    const otEnabledArr = (s.ot_enabled_locations || '').split(',');
    
    return state.db.locations.map(l => {
      const isChecked = otEnabledArr.includes(l.id) ? 'checked' : '';
      const config = customRates[l.id] || { type: 'flat', flatRate: s.ot_rate_per_hr || '8.00', ranks: { PENYELIA: '9.80', AHLI: '8.00', KPR: '8.00', KPRK: '8.00' } };
      
      const isFlat = config.type === 'flat' ? 'selected' : '';
      const isRank = config.type === 'rank' ? 'selected' : '';
      
      return `
        <div class="p-4 bg-white border border-slate-150 rounded-2xl shadow-sm space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" name="ot_loc_${l.id}" value="${l.id}" ${isChecked} onchange="toggleOtLocationJS('${l.id}', this.checked)" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
            <span class="text-xs font-black text-slate-800 uppercase">[${l.short}] ${l.name}</span>
          </label>
          
          <div id="ot-config-panel-${l.id}" class="${isChecked ? '' : 'hidden'} pl-7 pt-2 border-t border-dashed border-slate-100 space-y-3">
            <div class="flex items-center justify-between gap-4">
              <span class="text-[9px] font-black uppercase text-slate-400">Aturan Sesi OT</span>
              <select onchange="changeOtConfigTypeJS('${l.id}', this.value)" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-[10px] font-bold outline-none">
                <option value="flat" ${isFlat}>Kadar Flat (Sama Rata)</option>
                <option value="rank" ${isRank}>Kadar Mengikut Pangkat</option>
              </select>
            </div>
            
            <!-- Flat Panel -->
            <div id="panel-ot-flat-${l.id}" class="${config.type === 'flat' ? '' : 'hidden'} flex items-center justify-between gap-4">
              <span class="text-[9px] font-black uppercase text-slate-400">Kadar Jam (RM/Jam)</span>
              <input type="number" step="0.1" value="${config.flatRate || '8.00'}" onchange="updateOtConfigValJS('${l.id}', 'flatRate', this.value)" class="w-24 px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-xl text-[10px] font-bold text-center outline-none">
            </div>
            
            <!-- Rank Panel -->
            <div id="panel-ot-rank-${l.id}" class="${config.type === 'rank' ? '' : 'hidden'} space-y-2 bg-slate-50/50 p-3 rounded-xl border border-slate-150 border-l-2 border-l-emerald-500">
              <div class="flex items-center justify-between gap-4">
                <span class="text-[9px] font-black uppercase text-slate-500">Penyelia (RM/Jam)</span>
                <input type="number" step="0.1" value="${(config.ranks && config.ranks.PENYELIA) || '9.80'}" onchange="updateOtConfigRankValJS('${l.id}', 'PENYELIA', this.value)" class="w-20 px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-center outline-none">
              </div>
              <div class="flex items-center justify-between gap-4">
                <span class="text-[9px] font-black uppercase text-slate-500">Ahli (RM/Jam)</span>
                <input type="number" step="0.1" value="${(config.ranks && config.ranks.AHLI) || '8.00'}" onchange="updateOtConfigRankValJS('${l.id}', 'AHLI', this.value)" class="w-20 px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-center outline-none">
              </div>
              <div class="flex items-center justify-between gap-4">
                <span class="text-[9px] font-black uppercase text-slate-500">KPR (RM/Jam)</span>
                <input type="number" step="0.1" value="${(config.ranks && config.ranks.KPR) || '8.00'}" onchange="updateOtConfigRankValJS('${l.id}', 'KPR', this.value)" class="w-20 px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-center outline-none">
              </div>
              <div class="flex items-center justify-between gap-4">
                <span class="text-[9px] font-black uppercase text-slate-500">KPRK (RM/Jam)</span>
                <input type="number" step="0.1" value="${(config.ranks && config.ranks.KPRK) || '8.00'}" onchange="updateOtConfigRankValJS('${l.id}', 'KPRK', this.value)" class="w-20 px-3 py-1 bg-white border border-slate-200 rounded-lg text-[10px] font-bold text-center outline-none">
              </div>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // --- KOMPONEN: DASHBOARD ---
  function buildDashboard(c, mems, state) {
    let stats = { rm: 0, hrs: 0, days: 0, staff: mems.length };
    mems.forEach(m => {
       const s = calcMemberStats(m.id, state);
       stats.rm += s.total;
       stats.hrs += s.hrs;
       stats.days += s.dys;
     });
    stats.hrs = Number(stats.hrs.toFixed(2));
    const pendings = getPendingApprovals(state);
    const actives = getActiveWorkers(state);
    const isLocked = state.isMonthLocked();
    const klTimeStr = new Date().toLocaleString("en-US", {timeZone: "Asia/Kuala_Lumpur"});
    const klTime = new Date(klTimeStr);
    const currY = klTime.getFullYear();
    const currM = klTime.getMonth() + 1;
    const currD = klTime.getDate();
    
    const isCurrentMonthExceeded = (state.year === currY && state.month === currM) && currD >= 5;
    const isManualLocked = state.db.settings[`lock_${state.year}_${state.month}`] === 'true';
    let auditHeaderHtml = '';
    
    if (isLocked) {
      let sebabKunci = "ARKIB DITUTUP";
      let keteranganKunci = "Data berada di masa lampau dan telah dimuktamadkan untuk pengauditan kewangan.";
      if (isManualLocked) {
        sebabKunci = "KUNCI PENTADBIR";
        keteranganKunci = "Tuan Pentadbir (TPRD) telah mengunci bulan ini secara manual dari modul Tetapan.";
      } else if (isCurrentMonthExceeded) {
        sebabKunci = "AUTO-LOCK (5HB)";
        keteranganKunci = "Data bulan lepas telah dikunci secara automatik kerana telah melepasi tarikh akhir 5hb semasa.";
      }
      auditHeaderHtml = `
        <div class="mb-8 p-6 sm:p-8 bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950/40 rounded-[2.5rem] text-white border border-rose-500/30 shadow-2xl shadow-rose-950/20 relative overflow-hidden page-transition">
          <div class="absolute top-0 right-0 w-80 h-80 bg-rose-50/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex items-start gap-5">
              <div class="w-16 h-16 bg-gradient-to-br from-rose-50 to-red-700 text-white rounded-2xl flex items-center justify-center shadow-xl shadow-rose-500/20 shrink-0 border border-rose-400/30 animate-pulse">
                <i class="fas fa-shield-halved text-2xl"></i>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-black uppercase tracking-widest leading-none">Menara Kawalan Audit</h3>
                  <span class="bg-rose-500/20 border border-rose-500/50 text-rose-400 text-[9px] font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider animate-pulse flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-50"></span> ${sebabKunci}
                  </span>
                </div>
                <p class="text-xs text-rose-200/80 font-bold mt-2 leading-relaxed max-w-2xl">${keteranganKunci}</p>
                <div class="flex items-center gap-4 mt-3 text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                  <span><i class="fas fa-calendar-day mr-1 text-rose-500"></i> Rekod: ${M_NAMES[state.month-1].toUpperCase()} ${state.year}</span>
                  <span class="hidden sm:inline">&bull;</span>
                  <span><i class="fas fa-fingerprint mr-1 text-rose-500"></i> Kunci Sesi: AKTIF</span>
                </div>
              </div>
            </div>
            
            <div class="w-full md:w-auto shrink-0 flex flex-row md:flex-col gap-3 justify-between bg-white/5 border border-white/10 p-4 rounded-2xl">
              <div class="text-left md:text-right">
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Hak Akses Penyelia</p>
                <p class="text-sm font-black text-rose-400 uppercase tracking-wider mt-1"><i class="fas fa-ban mr-1"></i> Disekat (Read-Only)</p>
              </div>
              <div class="h-px bg-white/10 my-1 hidden md:block"></div>
              <div class="text-left md:text-right">
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Override Pentadbir</p>
                <p class="text-sm font-black text-emerald-400 uppercase tracking-wider mt-1"><i class="fas fa-key mr-1"></i> TPRD Aktif</p>
              </div>
            </div>
          </div>
        </div>`;
    } else {
      let jenisTerbuka = "SESI AKTIF";
      let descTerbuka = "Borang pengisian jadual roster dan laporan kehadiran sedia menerima kemasukan data harian.";
      const isRosterLockedNow = state.isRosterLocked();
      
      if (isRosterLockedNow && state.year === currY && state.month === currM) {
        jenisTerbuka = "KAWALAN ROSTER & KEHADIRAN (SELEPAS 5HB)";
        descTerbuka = "Jadual tugas bulan semasa telah dikunci secara automatik. Penyelia dibenarkan mengedit kehadiran sekiranya terdapat pembetulan jam bertugas sah.";
      } else if (state.year > currY || (state.year === currY && state.month > currM)) {
        jenisTerbuka = "PERANCANGAN ROSTER";
        descTerbuka = "Sesi plot jadual syif masa depan dibuka sepenuhnya. Sila rancang plot penugasan lebih awal.";
      }
      auditHeaderHtml = `
        <div class="mb-8 p-6 sm:p-8 bg-gradient-to-br from-slate-950 via-slate-900 to-emerald-950/30 rounded-[2.5rem] text-white border border-emerald-500/30 shadow-2xl shadow-emerald-950/20 relative overflow-hidden page-transition">
          <div class="absolute top-0 right-0 w-80 h-80 bg-emerald-50/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
          <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div class="flex items-start gap-5">
              <div class="w-16 h-16 bg-gradient-to-br from-emerald-50 to-teal-700 text-white rounded-2xl flex items-center justify-center shadow-xl shadow-emerald-500/20 shrink-0 border border-emerald-400/30">
                <i class="fas fa-lock-open text-2xl"></i>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-black uppercase tracking-widest leading-none">Menara Kawalan Audit</h3>
                  <span class="bg-emerald-500/20 border border-emerald-500/50 text-emerald-400 text-[9px] font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-ping"></span> ${jenisTerbuka}
                  </span>
                </div>
                <p class="text-xs text-emerald-200/80 font-bold mt-2 leading-relaxed max-w-2xl">${descTerbuka}</p>
                <div class="flex items-center gap-4 mt-3 text-[10px] text-slate-400 font-bold uppercase tracking-wider">
                  <span><i class="fas fa-calendar-day mr-1 text-emerald-500"></i> Rekod: ${M_NAMES[state.month-1].toUpperCase()} ${state.year}</span>
                  <span class="hidden sm:inline">&bull;</span>
                  <span><i class="fas fa-hourglass-half mr-1 text-emerald-500"></i> Auto-Lock: 5hb Depan</span>
                </div>
              </div>
            </div>
            
            <div class="w-full md:w-auto shrink-0 flex flex-row md:flex-col gap-3 justify-between bg-white/5 border border-white/10 p-4 rounded-2xl">
              <div class="text-left md:text-right">
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Hak Akses Penyelia</p>
                <p class="text-sm font-black text-emerald-400 uppercase tracking-wider mt-1"><i class="fas fa-edit mr-1"></i> Dibenarkan Tulis</p>
              </div>
              <div class="h-px bg-white/10 my-1 hidden md:block"></div>
              <div class="text-left md:text-right">
                <p class="text-[8px] font-black text-slate-400 uppercase tracking-widest">Override Pentadbir</p>
                <p class="text-sm font-black text-emerald-400 uppercase tracking-wider mt-1"><i class="fas fa-key mr-1"></i> TPRD Aktif</p>
              </div>
            </div>
          </div>
        </div>`;
    }

    // MODUL PINTAR: PUSAT PEMANTAUAN LOG QR & GEOFENCE OPERASI
    let qrMonitorSectionHtml = '';
    const totalActive = actives.length;
    const totalPending = pendings.length;

    qrMonitorSectionHtml = `
      <div class="mb-10 space-y-6">
        <!-- Pengepala Hab Pemantauan QR -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shadow-lg shadow-indigo-500/20">
              <i class="fas fa-satellite-dish text-base animate-pulse"></i>
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-black text-slate-900 uppercase tracking-wide">Pusat Pemantauan QR & Radar Geofence</h3>
              <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Semakan Integriti Waktu, Kedudukan Lapangan & Serah Tugas</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-black uppercase flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span> ${totalActive} Petugas Aktif
            </span>
            ${totalPending > 0 ? `
              <span class="px-3 py-1.5 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-black uppercase flex items-center gap-1.5">
                <i class="fas fa-bell animate-bounce text-amber-500"></i> ${totalPending} Menunggu Pengesahan
              </span>
            ` : ''}
          </div>
        </div>

