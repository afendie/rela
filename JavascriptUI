  window.resolveDynamicTitleJS = function(templateStr, locName = '', state = null) {
    const st = state || window.appState;
    const daerah = (st && st.db && st.db.settings && st.db.settings.report_daerah) || 'BATU PAHAT';
    const bulan = (st && st.month) ? M_NAMES[st.month - 1].toUpperCase() : 'OKTOBER';
    const tahun = (st && st.year) ? String(st.year) : '2026';
    const lokasi = locName || ((st && st.getActiveLocName) ? st.getActiveLocName() : 'LOKASI');

    return String(templateStr || '')
      .replace(/{lokasi}|{loc}/gi, lokasi)
      .replace(/{daerah}/gi, daerah)
      .replace(/{bulan}/gi, bulan)
      .replace(/{tahun}/gi, tahun);
  };

  window.updateTitlePreviewJS = function(fieldKey, rawTemplate) {
    const prevEl = document.getElementById(`prev-title-${fieldKey}`);
    if (!prevEl) return;
    const sampleLoc = fieldKey.includes('nbc') ? 'PGA MINYAK BEKU' : 'JPN YONG PENG';
    prevEl.textContent = window.resolveDynamicTitleJS(rawTemplate, sampleLoc);
  };

