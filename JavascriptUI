  let tempImportQueue = [];
  function preflightExcelParseJS() {
    const rawText = document.getElementById('excel-paste-area').value.trim(); if(!rawText) return alertMsg('Sila tampal data Excel terlebih dahulu.', 'warning');
    const lines = rawText.split('\n'); const st = window.appState; tempImportQueue = []; let errorLines = [];
    
    lines.forEach((line, index) => {
      if(!line.trim()) return; const cols = line.split('\t');
      if(cols.length < 8) { errorLines.push(`Baris ${index+1}: Lajur tidak lengkap (Kurang dari 8 lajur asas).`); return; }
      
      const nama = cols[0].toUpperCase().trim(); let kp = cols[1].replace(/[^0-9]/g, '').trim(); let tel = cols[2].replace(/[^0-9]/g, '').trim();
      const pangkat = cols[3].toUpperCase().trim(); const kadar = parseFloat(cols[4]) || 8.00; const bank = cols[5].toUpperCase().trim();
      let akaun = cols[6].replace(/[^0-9]/g, '').trim(); const locId = cols[7].trim();
      const noAhli = cols[8] ? cols[8].trim() : '';
      const sme = (cols[9] && cols[9].toUpperCase().trim() === 'YA') ? 'YA' : 'TIDAK';

      if (st.role === 'penyelia' && !st.allowedLocs.split(',').includes(locId)) { errorLines.push(`Baris ${index+1}: Sektor [${locId}] di luar jagaan anda.`); return; }
      if(!st.db.locations.some(l => l.id === locId)) { errorLines.push(`Baris ${index+1}: Cawangan [${locId}] tiada dalam sistem.`); return; }
      if(kp.length !== 12) { errorLines.push(`Baris ${index+1}: KP mestilah berjarak 12 digit.`); return; }

      // PINTAR: Semak sekiranya ada duplikasi pada lokasi yang sama di dalam pangkalan sedia ada
      const alreadyInLoc = st.db.members.some(x => String(x.kp).replace(/[^0-9]/g, '') === kp && x.locId === locId);
      if (alreadyInLoc) {
        errorLines.push(`Baris ${index+1}: Anggota (${kp}) sudah pun berdaftar di cawangan [${locId}].`);
        return;
      }

      tempImportQueue.push({ id: 'M_' + (Date.now() + index), locId, nama, kp, tel, pangkat, kadar, bank, akaun, noAhli, sme });
    });
    if(errorLines.length > 0) {
      tempImportQueue = []; const btn = document.getElementById('btn-import-execute'); btn.disabled = true; btn.className = "w-1/2 py-4 bg-slate-300 text-slate-500 rounded-2xl font-black text-xs uppercase tracking-widest cursor-not-allowed transition-all";
      document.getElementById('import-preflight-summary').className = "p-4 bg-rose-50 border border-rose-150 rounded-2xl text-left";
      document.getElementById('preflight-text').innerHTML = `Terdapat ralat pada data anda:<br>${errorLines.slice(0,4).map(e => `&bull; ${e}`).join('<br>')}`;
      document.getElementById('import-preflight-summary').classList.remove('hidden'); return alertMsg('Saringan gagal.', 'error');
    }
    document.getElementById('preflight-text').innerHTML = `Sejumlah <b>${tempImportQueue.length} baris data</b> sedia diserap masuk. Struktur data disahkan bersih.`;
    document.getElementById('import-preflight-summary').className = "p-4 bg-emerald-50 border border-emerald-150 rounded-2xl text-left";
    document.getElementById('import-preflight-summary').classList.remove('hidden');
    const btn = document.getElementById('btn-import-execute'); btn.disabled = false; btn.className = "w-1/2 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest shadow-xl active:scale-95 cursor-pointer transition-all";
  }

  function executeExcelImportJS() {
    if(tempImportQueue.length === 0) return; const st = window.appState; showLoading(true);
    if(typeof google !== 'undefined' && google.script) {
      google.script.run.withSuccessHandler((res) => {
          showLoading(false);
          if (res.success) {
            st.formModal.open = false;
            st.syncFromServer(false, true); // Silent background sync
            Swal.fire({ title: 'Import Selesai!', text: `Seramai ${tempImportQueue.length} anggota didaftarkan.`, icon: 'success', customClass: { popup: 'rounded-3xl' } });
            tempImportQueue = [];
          } else {
            alertMsg(res.msg, 'error');
          }
        }).withFailureHandler(err => { showLoading(false); alertMsg('Ralat Pukal: ' + err.message, 'error'); }).saveMembersBulkSecure(sessionStorage.getItem('relaToken'), tempImportQueue);
    } else {
      showLoading(false); st.formModal.open = false; st.db.members.push(...tempImportQueue); st.renderData(); alertMsg('Import Berjaya (Mod Demo)'); tempImportQueue = [];
    }
  }

