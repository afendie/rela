  // Menguruskan pertukaran suis mod pukal kalendar
  function toggleCalBulkModeJS() {
    const st = window.appState;
    st.calModal.selectedDays = [];
    st.calModal.selDay = null;
    
    renderCalGridJS();
    renderCalButtonsJS();
  }

  // Menguruskan kemasukan manual jam bertugas bagi kes lewat/disiplin
  function applyManualHoursJS() {
    const inputEl = document.getElementById('manual-jam-input');
    if (!inputEl) return;
    const val = parseFloat(inputEl.value);

    if (isNaN(val) || val <= 0 || val > 24) {
      return alertMsg('Sila masukkan nilai jam yang sah antara 0.5 hingga 24 jam.', 'warning');
    }

    // Format nombor (cth: 7 atau 7.5)
    const formattedVal = (val % 1 === 0) ? val.toString() : val.toFixed(1);
    handleCalActionJS(formattedVal);
  }

  // Gelagat menanda / membuang pilihan hari dalam Mod Pukal
  function toggleDaySelectionJS(day) {
    const st = window.appState;
    const idx = st.calModal.selectedDays.indexOf(day);
    if (idx > -1) {
      st.calModal.selectedDays.splice(idx, 1);
    } else {
      st.calModal.selectedDays.push(day);
    }
    renderCalGridJS();
    renderCalButtonsJS();
  }

  // Memilih semua atau membersihkan semua tarikh kalendar bertugas secara pintas
  function bulkSelectAllDaysJS(shouldSelectAll) {
    const st = window.appState;
    if (shouldSelectAll) {
      const max = new Date(st.year, st.month, 0).getDate();
      const m = st.db.members.find(x => x.id === st.calModal.memId);
      
      const days = [];
      for (let d = 1; d <= max; d++) {
        const isDayLocked = st.calModal.mode === 'att' ? st.isAttendanceLocked(d, m.id) : st.isRosterLocked(d);
        if (st.role === 'admin' || !isDayLocked) {
          days.push(d);
        }
      }
      st.calModal.selectedDays = days;
    } else {
      st.calModal.selectedDays = [];
    }
    
    renderCalGridJS();
    renderCalButtonsJS();
  }

  // Menguruskan peruntukan nilai jam/syif bertugas kepada tarikh-tarikh terpilih
  function handleCalActionJS(val) {
    const st = window.appState;
    if (st.calModal.isBulk) {
      if (st.calModal.selectedDays.length === 0) {
        return alertMsg('Sila pilih sekurang-kurangnya satu hari pada kalendar.', 'warning');
      }
      
      const m = st.db.members.find(x => x.id === st.calModal.memId);
      const loc = st.locId === 'all' ? m.locId : st.locId;
      
      st.calModal.selectedDays.forEach(d => {
        const k = `${loc}-${m.id}-${st.year}-${st.month}-${d}`;
        if (st.calModal.mode === 'att' && val !== '' && st.role !== 'admin') {
          const rosVal = st.db.roster[k] || '';
          if (rosVal === '' || rosVal === 'OFF' || rosVal === 'CUTI' || rosVal === 'X') {
            return; // Abaikan hari bertugas yang tiada jadual syif (Anti-Fraud)
          }
        }
        
        // Kemaskini tatasusunan memori tempatan (Optimistic Preview)
        if (st.calModal.mode === 'att') {
          if (val === '') delete st.db.attendance[k];
          else st.db.attendance[k] = val;
        } else {
          if (val === '') delete st.db.roster[k];
          else st.db.roster[k] = val;
        }
      });
      
      alertMsg(`Nilai diterapkan pada ${st.calModal.selectedDays.length} hari! Sila klik 'SIMPAN REKOD PUKAL' untuk memuktamadkan.`);
      renderCalGridJS();
      renderCalButtonsJS();
    } else {
      saveCalValJS(val); // Mod Tunggal Lalai
    }
  }

  // Menghantar data kelompok pukal ke pelayan GAS dengan penutupan spinner segera & Penyelarasan Senyap (Silent Sync)
  function saveBulkCalendarEntriesJS() {
    const st = window.appState;
    if (st.calModal.selectedDays.length === 0) return;
    
    showLoading(true);
    const m = st.db.members.find(x => x.id === st.calModal.memId);
    const loc = st.locId === 'all' ? m.locId : st.locId;
    
    const updates = st.calModal.selectedDays.map(d => {
      const k = `${loc}-${m.id}-${st.year}-${st.month}-${d}`;
      const val = st.calModal.mode === 'att' ? (st.db.attendance[k] || '') : (st.db.roster[k] || '');
      return { key: k, val: val };
    });
    if (typeof google !== 'undefined' && google.script) {
      google.script.run
        .withSuccessHandler((res) => {
          showLoading(false); // Tutup spinner sejurus kembali dari pelayan untuk mengelakkan ralat masa tamat!
          if (res && res.success === false) {
            return alertMsg(res.msg, 'error');
          }
          st.calModal.open = false;
          st.syncFromServer(false, true); // JALANKAN PROSES PENYELARASAN SECARA SENYAP (SILENT BACKGROUND SYNC)
          Swal.fire({
            title: 'Berjaya!',
            text: `Sejumlah ${updates.length} rekod harian berjaya dikemaskini secara kelompok pukal.`,
            icon: 'success',
            customClass: { popup: 'rounded-3xl' }
          });
        })
        .withFailureHandler(err => {
          showLoading(false);
          alertMsg('Ralat simpan pukal: ' + (err.message || err), 'error');
        })
        .saveCalendarEntriesBulkSecure(sessionStorage.getItem('relaToken'), st.calModal.mode, updates);
    } else {
      showLoading(false);
      st.calModal.open = false;
      st.renderData();
      alertMsg('Pilihan pukal disimpan (Mod Demo Offline)', 'success');
    }
  }

  // Menyimpan data perubahan tunggal dengan respons hibrid visual instant dan Penyelarasan Senyap (Silent Sync)
  function saveCalValJS(val) {
    const st = window.appState; 
    if(!st.calModal.selDay) return; 
    const m = st.db.members.find(x=>x.id===st.calModal.memId); 
    const loc = st.locId === 'all' ? m.locId : st.locId; 
    const k = `${loc}-${m.id}-${st.year}-${st.month}-${st.calModal.selDay}`;
     
    const isLocked = st.calModal.mode === 'att' ? st.isAttendanceLocked(st.calModal.selDay, m.id) : st.isRosterLocked(st.calModal.selDay);
    if (isLocked && st.role !== 'admin') {
      return alertMsg('Sesi hari ini dikunci daripada sebarang modifikasi.', 'error');
    }
    let backupVal = st.calModal.mode === 'att' ? st.db.attendance[k] : st.db.roster[k];
    
    // 1. KEMASKINI OPTIMISTIK TEMPATAN (Serta-merta bertukar tanpa spinner menyekat skrin)
    if(st.calModal.mode === 'att') { 
       if (val !== '' && st.role !== 'admin') {
         const rosVal = st.db.roster[k] || ''; 
         if (rosVal === '' || rosVal === 'OFF' || rosVal === 'CUTI' || rosVal === 'X') {
           return alertMsg('Anggota tidak mempunyai jadual kerja pada tarikh ini!', 'error');
         }
       }
       if(val === '') delete st.db.attendance[k]; 
       else st.db.attendance[k] = val;
    } else { 
       if(val === '') delete st.db.roster[k]; 
       else st.db.roster[k] = val;
    }
    st.renderData(); // Visual background instant ditukar!

    if(typeof google !== 'undefined' && google.script) {
      // Dilakukan secara senyap (tanpa memaparkan modal pemutar biru menyekat operasi)
      google.script.run
      .withSuccessHandler((res) => {
        if (res && res.success === false) {
          // Rollback data jika pelayan gagal
          if(st.calModal.mode === 'att') {
            if(!backupVal) delete st.db.attendance[k]; else st.db.attendance[k] = backupVal;
          } else {
            if(!backupVal) delete st.db.roster[k]; else st.db.roster[k] = backupVal;
          }
          st.renderData();
          return alertMsg(res.msg, 'error');
        }
        st.syncFromServer(false, true); // Silent background sync untuk data pengiraan gaji harian
        const max = new Date(st.year, st.month, 0).getDate(); 
        if(st.calModal.selDay < max) { 
           st.calModal.selDay++; 
           renderCalGridJS(); 
           renderCalButtonsJS(); 
        } else { 
           st.calModal.open = false; 
           alertMsg('Rekod berjaya dikemaskini.'); 
        } 
      })
      .withFailureHandler(err => {
        // Rollback data jika gagal bersambung
        if(st.calModal.mode === 'att') {
          if(!backupVal) delete st.db.attendance[k]; else st.db.attendance[k] = backupVal;
        } else {
          if(!backupVal) delete st.db.roster[k]; else st.db.roster[k] = backupVal;
        }
        st.renderData();
        alertMsg('Gagal menyelaraskan rekod ke awan pelayan.', 'error');
      })
      .saveCalendarEntrySecure(sessionStorage.getItem('relaToken'), st.calModal.mode, k, val);
    } else {
      const max = new Date(st.year, st.month, 0).getDate();
      if(st.calModal.selDay < max) { 
        st.calModal.selDay++; 
        renderCalGridJS(); 
        renderCalButtonsJS(); 
      } else { 
        st.calModal.open = false; 
      }
    }
  }

