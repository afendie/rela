  // --- KOMPONEN: PREVIEW TUGASAN ---
  function renderPreview(mode, mems, state) {
    const day = mode === 'att' ? state.previewAttDay : state.previewRosDay;
    const maxD = new Date(state.year, state.month, 0).getDate(); 
    if (day > maxD) return '';
    let html = '';
    mems.forEach(m => {
      const loc = state.locId === 'all' ? m.locId : state.locId; 
      const key = `${loc}-${m.id}-${state.year}-${state.month}-${day}`; 
      const val = mode === 'att' ? state.db.attendance[key] : state.db.roster[key];
      if (mode === 'ros') {
        const v = val || ''; 
        const isOff = v === 'X' || v === 'CUTI' || v === 'OFF'; 
        const syifCat = isOff ? 'OFF' : (v ? v : 'KOSONG'); 
        if (state.rosFilter !== 'ALL' && syifCat !== state.rosFilter) return;
        if (v) { 
          html += `
            <div class="p-4 flex justify-between items-center hover:bg-white transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-2xl ${isOff ? 'bg-rose-50 text-rose-600 border border-rose-100' : 'bg-emerald-50 text-emerald-600 border border-emerald-100'} flex items-center justify-center font-black text-sm shadow-sm">${m.nama.charAt(0)}</div>
                <div>
                  <p class="text-[11px] font-black text-slate-800 uppercase truncate max-w-[150px] sm:max-w-[250px] tracking-tight">${m.nama}</p>
                  <p class="text-[9px] text-slate-400 font-bold uppercase mt-0.5 tracking-widest">${m.pangkat}</p>
                </div>
              </div>
              <span class="px-3 py-1.5 ${isOff ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-700'} rounded-xl text-[9px] font-black uppercase tracking-widest shadow-sm">${v}</span>
            </div>`; 
        }
      } else {
        if (val && val !== 'X' && val !== 'OFF' && val !== '') {
          const rosterVal = state.db.roster[key] || '';
          const resolved = resolveAttendanceDisplay(val, rosterVal);
          let badgeClass = 'bg-blue-600 text-white';
          if (resolved.status === 'Aktif') badgeClass = 'bg-emerald-600 text-white animate-pulse';
          if (resolved.status === 'Menunggu Pengesahan') badgeClass = 'bg-amber-500 text-white';
          
          html += `
            <div class="p-4 flex justify-between items-center hover:bg-white transition-colors">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center font-black text-sm shadow-sm">${m.nama.charAt(0)}</div>
                <div>
                  <p class="text-[11px] font-black text-slate-800 uppercase truncate max-w-[150px] sm:max-w-[250px] tracking-tight">${m.nama}</p>
                  <p class="text-[9px] text-slate-400 font-bold uppercase mt-0.5 tracking-widest">${m.pangkat} &bull; <i class="fas fa-clock mr-0.5"></i> ${resolved.inTime} - ${resolved.outTime}</p>
                </div>
              </div>
              <span class="px-3 py-1.5 ${badgeClass} rounded-xl text-[10px] font-black uppercase tracking-widest shadow-md">${resolved.duration}</span>
            </div>`;
        }
      }
    }); 
    return html || `<div class="py-10 text-center opacity-40 uppercase font-black text-xs">Tiada Rekod pada Tarikh Ini</div>`;
  }

  // Menapis data senarai berasaskan input pengguna
  function filterList(inputId, containerId) {
    const term = document.getElementById(inputId).value.toLowerCase(); 
    const container = document.getElementById(containerId); 
    if (!container) return;
    const items = container.children;
    for (let i = 0; i < items.length; i++) {
      const item = items[i]; 
      if (item.tagName === 'STYLE' || item.tagName === 'SCRIPT' || item.id === 'no-data-placeholder') continue;
      item.style.display = item.innerText.toLowerCase().includes(term) ? '' : 'none';
    }
  }

  // Membuka paparan kalendar mini bagi pengubahsuaian pantas (DENGAN RESET MOD PUKAL)
  function openCalendarModalJS(memId, mode, prefillDay = null) {
    const st = window.appState;
    if (mode === 'ros' && st.isRosterLocked() && st.role !== 'admin') {
      return alertMsg('Jadual tugas bulan ini telah dikunci.', 'error');
    }
    if (mode === 'att' && st.isMonthLocked() && st.role !== 'admin') {
      return alertMsg('Rekod kehadiran bulan lepas telah dikunci sepenuhnya.', 'error');
    }
    
    const m = st.db.members.find(x => x.id === memId);
    st.calModal.memId = m.id;
    st.calModal.memName = m.nama;
    st.calModal.mode = mode;
    st.calModal.selDay = prefillDay;
    st.calModal.isBulk = false; // Set semula mod pukal kepada tidak aktif
    st.calModal.selectedDays = []; // Kosongkan hari pilihan
    renderCalGridJS();
    renderCalButtonsJS(); // Bina semula butang secara dinamik
    st.calModal.open = true;
  }

  // Menjana paparan grid hari bagi bulan semasa di modal (DENGAN SERLAHAN MOD PUKAL PREMIUM & PEMBERSIHAN PAPARAN TEKS JAM BERSIH)
  function renderCalGridJS() {
     const st = window.appState;
     const max = new Date(st.year, st.month, 0).getDate();
     const m = st.db.members.find(x => x.id === st.calModal.memId);
     const loc = st.locId === 'all' ? m.locId : st.locId;
     
     let h = '';
     for(let d=1; d<=max; d++) {
       const k = `${loc}-${m.id}-${st.year}-${st.month}-${d}`;
       const rawVal = st.calModal.mode === 'att' ? st.db.attendance[k] : st.db.roster[k];
       
       const isDayLocked = st.calModal.mode === 'att' ? st.isAttendanceLocked(d, m.id) : st.isRosterLocked(d);
       
       // Mengesan status pilihan berasaskan mod aktif (Pukal vs Tunggal)
       const isSel = st.calModal.isBulk
          ? st.calModal.selectedDays.includes(d)
          : st.calModal.selDay === d;
       
       // SARI KELUAR NILAI JAM BERSIH (Bersihkan nota panjang GPS/Auto-snap daripada mencemari petak kalendar)
       let cleanDisplay = '';
       let hasPending = false;
       if (rawVal) {
         if (st.calModal.mode === 'att') {
           if (rawVal.startsWith('IN:')) {
             cleanDisplay = 'IN';
           } else {
             cleanDisplay = rawVal.split('|')[0].replace('?', '').trim();
             if (rawVal.includes('?')) hasPending = true;
           }
         } else {
           if (rawVal === 'PAGI') cleanDisplay = 'P';
           else if (rawVal === 'PETANG') cleanDisplay = 'PT';
           else if (rawVal === 'MALAM') cleanDisplay = 'M';
           else if (rawVal === 'OFF' || rawVal === 'CUTI' || rawVal === 'X') cleanDisplay = 'O';
           else cleanDisplay = rawVal;
         }
       }

       let cls = 'bg-white border-slate-150 text-slate-400 hover:bg-slate-50';
       if(cleanDisplay) {
         if (hasPending) {
           cls = 'bg-amber-50 border-amber-300 text-amber-700 font-black animate-pulse';
         } else {
           cls = st.calModal.mode === 'att' 
             ? 'bg-blue-50 border-blue-200 text-blue-700 font-black' 
             : 'bg-emerald-50 border-emerald-200 text-emerald-700 font-black';
         }
       }
       
       if(isSel) {
        cls = st.calModal.mode === 'att' 
          ? 'bg-blue-600 border-blue-600 text-white shadow-xl scale-105 z-10 font-black' 
