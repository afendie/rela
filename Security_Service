/**
 * SISTEM PENGURUSAN TUNTUTAN ELAUN RELA - BATU PAHAT
 * Fail: Security_Service.gs (Enjin Penyulitan, Sesi & Brute-Force Rate Limiter)
 * 
 * Menyediakan fungsi penyulitan sehala SHA-256 bagi perlindungan kata laluan,
 * pengesanan tracking brute-force log masuk salah, dan validasi jangka hayat token sesi.
 */

// ======================================================================
// 1. PENYULITAN KRIPTOGRAFI SEHALA SHA-256 KORPORAT
// ======================================================================
function sha256_(text) {
  try {
    const raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text || ''), Utilities.Charset.UTF_8);
    return raw.map(b => ('0' + (b & 0xFF).toString(16)).slice(-2)).join('');
  } catch (e) {
    return "";
  }
}

// ======================================================================
// 2. MEMERIKSA STATUS SEKATAN LOG MASUK SEMENTARA (BRUTE-FORCE LOCKOUT)
// ======================================================================
function checkLock_(key) {
  try {
    const cache = CacheService.getScriptCache();
    const lock = cache.get("LOCK_" + key);
    if (!lock) return null;
    
    const data = JSON.parse(lock);
    if (Date.now() > data.until) {
      cache.remove("LOCK_" + key);
      return null;
    }
    return data;
  } catch (e) {
    return null;
  }
}

// ======================================================================
// 3. MEREKOD DAN MEMPROSES KADAR KEGAGALAN CUBAAN LOG MASUK
// ======================================================================
function recordFail_(key) {
  try {
    const cache = CacheService.getScriptCache();
    const failKey = "FAIL_" + key;
    let count = parseInt(cache.get(failKey) || "0", 10);
    count++;
    cache.put(failKey, String(count), 600); // Simpan pembilang selama 10 minit (600 saat)

    if (count >= 5) {
      const until = Date.now() + (5 * 60 * 1000); // Kunci selama 5 minit jika salah 5 kali
      cache.put("LOCK_" + key, JSON.stringify({ until, count }), 300);
      cache.remove(failKey);
      return { locked: true, until };
    }
    return { locked: false, count };
  } catch (e) {
    return { locked: false, count: 0 };
  }
}

// ======================================================================
// 4. SET SEMULA KADAR KEGAGALAN APABILA LOG MASUK BERJAYA
// ======================================================================
function resetFail_(key) {
  try {
    const cache = CacheService.getScriptCache();
    cache.remove("FAIL_" + key);
    cache.remove("LOCK_" + key);
  } catch (e) {
    console.error("Gagal menetapkan semula kunci ralat:", e);
  }
}

// ======================================================================
// 5. MENJANA TOKEN SESI RAWAK UUID (12 JAM SESI SYIF LENGKAP)
// ======================================================================
function createSession_(role, user, locId) {
  try {
    const token = Utilities.getUuid();
    const sessionDurationSec = 12 * 60 * 60; // 12 Jam (43,200 saat) bagi menampung syif bertugas penuh
    const exp = Date.now() + (sessionDurationSec * 1000);
    
    CacheService.getScriptCache().put(
      "SESS_" + token, 
      JSON.stringify({ role, user, locId, exp }), 
      sessionDurationSec
    );
    
    return { success: true, token, role, user, locId, exp };
  } catch (e) {
    return { success: false, msg: "Gagal menjana sesi pengguna: " + e.message };
  }
}

// ======================================================================
// 6. MENGESAHKAN KESAHIHAN TOKEN & SLIDING EXPIRATION
// ======================================================================
function verifySession_(token) {
  if (!token) return null;
  const cache = CacheService.getScriptCache();
  const raw = cache.get("SESS_" + token);
  if (!raw) return null;

  try {
    const sess = JSON.parse(raw);
    if (Date.now() > sess.exp) {
      cache.remove("SESS_" + token);
      return null;
    }

    // Mekanisme Sliding Expiration: Perbaharui jangka hayat sesi jika pengguna aktif
    const remainingTime = sess.exp - Date.now();
    if (remainingTime < (2 * 60 * 60 * 1000)) { // Baki kurang dari 2 jam
      const newDurationSec = 6 * 60 * 60; // Tambah 6 jam lagi
      sess.exp = Date.now() + (newDurationSec * 1000);
      cache.put("SESS_" + token, JSON.stringify(sess), newDurationSec);
    }
    return sess;
  } catch (e) {
    return null;
  }
}
